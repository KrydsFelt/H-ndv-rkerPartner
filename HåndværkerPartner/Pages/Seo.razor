@page "/seo"

<PageTitle>SEO – HåndværkerPartner</PageTitle>

<NavBar />

<div class="subpage">
    <div class="subpage-hero" style="background: #1a1a1a;">
        <div class="subpage-hero-inner">
            <p class="hero-badge">Søgemaskineoptimering</p>
            <h2>Bliv fundet organisk på Google</h2>
            <p class="hero-sub">SEO er den langsigtede investering der giver dig gratis trafik fra Google – dag efter dag, uden at betale for hvert klik.</p>
            <a href="kontakt" class="btn-primary">Anmod om gratis analyse</a>
        </div>
    </div>

    <div class="subpage-content">
        <div class="section-inner">
            <div class="subpage-grid">
                <div class="subpage-text">
                    <span class="section-tag">SEO for håndværkere</span>
                    <h2 class="section-title">Synlighed der <span>varer ved</span></h2>
                    <p class="section-subtitle">Vi optimerer din hjemmeside teknisk og indholdsmæssigt så Google rangerer dig højt på de søgninger dine potentielle kunder laver.</p>
                    <ul class="about-list" style="margin-top: 24px;">
                        <li><span class="check-icon">✓</span> Teknisk SEO-optimering af din hjemmeside</li>
                        <li><span class="check-icon">✓</span> Lokalt SEO – bliv fundet i dit område</li>
                        <li><span class="check-icon">✓</span> Søgeordsanalyse målrettet din branche</li>
                        <li><span class="check-icon">✓</span> Linkbuilding og autoritetsstyrkelse</li>
                        <li><span class="check-icon">✓</span> Månedlige rapporter med ranglisteudvikling</li>
                    </ul>
                </div>
                <div class="subpage-stats">
                    <div class="result-card-light" style="text-align:center; padding: 40px 32px;">
                        <div class="metric-value" style="font-size:48px; margin-bottom:8px;">Top 3</div>
                        <div style="color:var(--gray-text); font-size:15px; margin-bottom:24px;">Gennemsnitlig placering for vores kunder</div>
                        <div class="metric-value" style="font-size:48px; margin-bottom:8px;">6 mdr</div>
                        <div style="color:var(--gray-text); font-size:15px;">Typisk tid til synlige resultater</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="subpage-cta">
        <h2>Klar til at blive fundet på Google?</h2>
        <p>Book en gratis SEO-analyse af din hjemmeside.</p>
        <a href="kontakt" class="btn-primary">Få gratis analyse</a>
    </div>
</div>

<SiteFooter />
