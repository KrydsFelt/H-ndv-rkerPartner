@page "/seo"

<PageTitle>SEO - HåndværkerPartner</PageTitle>

<NavBar />

<div class="subpage">
    <div class="subpage-hero" style="background: #1a1a1a;">
        <div class="subpage-hero-inner">
            <p class="hero-badge">Søgemaskineoptimering</p>
            <h2>Bliv fundet på Google uden at betale for hvert klik</h2>
            <p class="hero-sub">Med SEO dukker din virksomhed op på Google af sig selv - dag efter dag, uden at du betaler for hvert klik.</p>
            <a href="kontakt" class="btn-primary">Få en gratis analyse</a>
        </div>
    </div>

    <div class="subpage-content">
        <div class="section-inner">
            <div class="subpage-grid">
                <div class="subpage-text">
                    <span class="section-tag">SEO for håndværkere</span>
                    <h2 class="section-title">Synlighed der <span>varer ved</span></h2>
                    <p class="section-subtitle">Vi gør din hjemmeside klar - både teknisk og i indholdet - så Google viser dig højt oppe når kunder søger efter dit fag.</p>
                    <ul class="about-list" style="margin-top: 24px;">
                        <li><span class="check-icon">✓</span> Vi tjekker og retter din hjemmeside teknisk</li>
                        <li><span class="check-icon">✓</span> Lokalt SEO - bliv fundet i dit område</li>
                        <li><span class="check-icon">✓</span> Vi finder de søgeord dine kunder bruger</li>
                        <li><span class="check-icon">✓</span> Vi bygger links der gør din side stærkere</li>
                        <li><span class="check-icon">✓</span> Du får en rapport hver måned med tallene</li>
                    </ul>
                </div>
                <div class="subpage-stats">
                    <div class="result-card-light" style="text-align:center; padding: 40px 32px;">
                        <div class="metric-value" style="font-size:48px; margin-bottom:8px;">Top 3</div>
                        <div style="color:var(--gray-text); font-size:15px; margin-bottom:24px;">Sådan ligger vores kunder typisk på Google</div>
                        <div class="metric-value" style="font-size:48px; margin-bottom:8px;">6 mdr</div>
                        <div style="color:var(--gray-text); font-size:15px;">Så lang tid tager det typisk før du kan se det</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<ProductPageCta />
<SiteFooter />
