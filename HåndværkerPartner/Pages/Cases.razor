@page "/cases"

<PageTitle>Cases – HåndværkerPartner</PageTitle>

<NavBar />

<div class="subpage">
    <div class="subpage-hero" style="background: #1a1a1a;">
        <div class="subpage-hero-inner">
            <p class="hero-badge">Kundecases</p>
            <h2>Resultater vi er stolte af</h2>
            <p class="hero-sub">Se hvad vi har opnået for håndværksvirksomheder ligesom din – i tal og citater fra de kunder vi arbejder med.</p>
        </div>
    </div>

    <div class="subpage-content">
        <div class="section-inner">
            <div class="cases-grid">
                <div class="case-card">
                    <div class="case-platform"><span class="platform-badge-light">Meta</span></div>
                    <h3>Mpuds.dk</h3>
                    <p class="case-period">10 måneders samarbejde</p>
                    <div class="result-metrics-light" style="margin-top:20px;">
                        <div class="metric-light"><div class="metric-value">33 kr</div><div class="metric-label-dark">Leadpris</div></div>
                        <div class="metric-light"><div class="metric-value">613</div><div class="metric-label-dark">Leads</div></div>
                        <div class="metric-light"><div class="metric-value">101 kr</div><div class="metric-label-dark">Pris/kunde</div></div>
                    </div>
                </div>

                <div class="case-card">
                    <div class="case-platform"><span class="platform-badge-light">Meta</span></div>
                    <h3>Nord Polering</h3>
                    <p class="case-period">6 måneders samarbejde</p>
                    <div class="result-metrics-light" style="margin-top:20px;">
                        <div class="metric-light"><div class="metric-value">54,5 kr</div><div class="metric-label-dark">Leadpris</div></div>
                        <div class="metric-light"><div class="metric-value">400</div><div class="metric-label-dark">Leads</div></div>
                        <div class="metric-light"><div class="metric-value">6 mdr</div><div class="metric-label-dark">Periode</div></div>
                    </div>
                </div>

                <div class="case-card">
                    <div class="case-platform"><span class="platform-badge-light">Meta</span> <span class="platform-badge-light">Google</span></div>
                    <h3>CT Isolering</h3>
                    <p class="case-period">12 måneders samarbejde</p>
                    <div class="result-metrics-light" style="margin-top:20px;">
                        <div class="metric-light"><div class="metric-value">92 kr</div><div class="metric-label-dark">Pris/lead</div></div>
                        <div class="metric-light"><div class="metric-value">967</div><div class="metric-label-dark">Leads</div></div>
                        <div class="metric-light"><div class="metric-value">12 mdr</div><div class="metric-label-dark">Periode</div></div>
                    </div>
                </div>

                <div class="case-card case-testimonial">
                    <div class="author-avatar" style="margin-bottom:16px;">B</div>
                    <p class="testimonial-quote">"Første gang hjalp de mig fra 20 kunder til 275, hvorefter jeg solgte min virksomhed. Nu har de hjulpet mig fra 10 kunder til over 50."</p>
                    <div class="author-name" style="margin-top:16px;">Berthel Kryger</div>
                    <div class="author-title">Berthels Vinduespolering</div>
                </div>

                <div class="case-card case-testimonial">
                    <div class="author-avatar" style="margin-bottom:16px;">K</div>
                    <p class="testimonial-quote">"Min virksomhed er på lidt under 1 år gået fra at være split nye til at levere en omsætning på formentligt over 2 millioner."</p>
                    <div class="author-name" style="margin-top:16px;">Kasper West</div>
                    <div class="author-title">Ejer af Kasper West</div>
                </div>

                <div class="case-card case-testimonial">
                    <div class="author-avatar" style="margin-bottom:16px;">E</div>
                    <p class="testimonial-quote">"HåndværkerPartner greb opgaven og udførte præcis den visuelle identitet som vi ønskede. Stor anbefaling herfra."</p>
                    <div class="author-name" style="margin-top:16px;">Eisho Dalil</div>
                    <div class="author-title">Ejer af Francis Marketing</div>
                </div>
            </div>
        </div>
    </div>

    <div class="subpage-cta">
        <h2>Vil du være vores næste case?</h2>
        <p>Lad os snakke om hvad vi kan gøre for din virksomhed.</p>
        <a href="/kontakt" class="btn-primary">Kontakt os i dag</a>
    </div>
</div>

<SiteFooter />
