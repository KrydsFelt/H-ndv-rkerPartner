@page "/kontakt"

<PageTitle>Kontakt – HåndværkerPartner</PageTitle>

<NavBar />

<main class="contact-page">
    <section class="contact-split">
        <div class="contact-split-copy">
            <p class="contact-eyebrow">Kontakt os</p>
            <h1>
                Sammen kan vi skabe
                <span>ekstraordinær vækst.</span>
            </h1>

            <a href="mailto:info@haandvaerkerpartner.dk" class="contact-mail-link">
                <span class="contact-mail-link-text">info@haandvaerkerpartner.dk</span>
            </a>
        </div>

        <div class="contact-form-panel">
            @if (formSent)
            {
                <div class="contact-success-card">
                    <h2>Tak for din henvendelse</h2>
                    <p>Vi vender tilbage inden for 24 timer på hverdage.</p>
                </div>
            }
            else
            {
                <div class="contact-form-shell">
                    <div class="contact-form-group">
                        <input class="contact-input" type="text" placeholder="Dit fulde navn" @bind="formName" />
                    </div>

                    <div class="contact-form-group">
                        <input class="contact-input" type="email" placeholder="Email" @bind="formEmail" />
                    </div>

                    <fieldset class="contact-interest-group">
                        <legend>Hvad er du interesseret i? <span>*</span></legend>

                        @foreach (var option in interestOptions)
                        {
                            <label class="contact-radio-option">
                                <input type="radio" name="interest" checked="@(selectedInterest == option)" @onchange="@(_ => selectedInterest = option)" />
                                <span class="contact-radio-mark" aria-hidden="true"></span>
                                <span>@option</span>
                            </label>
                        }
                    </fieldset>

                    <div class="contact-form-group">
                        <textarea class="contact-textarea" placeholder="Skriv din besked" @bind="formMessage"></textarea>
                    </div>

                    <button class="contact-submit" @onclick="SubmitForm">Send formular ↗</button>
                </div>
            }
        </div>
    </section>
</main>

<SiteFooter />

@code {
    private bool formSent;
    private string formName = string.Empty;
    private string formEmail = string.Empty;
    private string formMessage = string.Empty;
    private string selectedInterest = string.Empty;

    private readonly string[] interestOptions =
    [
        "Meta Ads",
        "Google Ads",
        "Webudvikling",
        "SEO",
        "Noget andet"
    ];

    private void SubmitForm()
    {
        if (!string.IsNullOrWhiteSpace(formName)
            && !string.IsNullOrWhiteSpace(formEmail)
            && !string.IsNullOrWhiteSpace(selectedInterest))
        {
            formSent = true;
        }
    }
}
