@page "/kontakt"

<PageTitle>Kontakt – HåndværkerPartner</PageTitle>

<NavBar />

<div class="kontakt-hero">
    <div class="kontakt-hero-inner">
        <p class="section-tag">Kom i gang</p>
        <h1>Lad os snakke om din vækst</h1>
        <p class="kontakt-hero-sub">Book en gratis og uforpligtende samtale og find ud af, om vi er det rette match for din virksomhed.</p>

        <div class="kontakt-info-row">
            <div class="kontakt-info-card">
                <div class="kontakt-info-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--orange)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.38 2 2 0 0 1 3.6 1.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.73a16 16 0 0 0 6.29 6.29l1.62-1.62a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </div>
                <div class="kontakt-info-label">Telefon</div>
                <div class="kontakt-info-value">Ring til os – ingen binding</div>
            </div>
            <div class="kontakt-info-card">
                <div class="kontakt-info-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--orange)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                </div>
                <div class="kontakt-info-label">E-mail</div>
                <div class="kontakt-info-value">info@haandvaerkerpartner.dk</div>
            </div>
            <div class="kontakt-info-card">
                <div class="kontakt-info-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--orange)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                </div>
                <div class="kontakt-info-label">Svartid</div>
                <div class="kontakt-info-value">Inden for 24 timer på hverdage</div>
            </div>
        </div>
    </div>
</div>

<div class="kontakt-form-section">
    <div class="kontakt-form-card">
        <h2>Gratis rådgivning</h2>
        <p class="kontakt-form-sub">Udfyld formularen – vi kontakter dig hurtigst muligt.</p>

        @if (formSent)
        {
            <div class="success-msg">✓ Tak! Vi kontakter dig inden for 24 timer.</div>
        }
        else
        {
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Navn</label>
                    <input class="form-control" type="text" placeholder="Dit fulde navn" @bind="formName" />
                </div>
                <div class="form-group">
                    <label class="form-label">Telefon</label>
                    <input class="form-control" type="tel" placeholder="Dit telefonnummer" @bind="formPhone" />
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">E-mail</label>
                <input class="form-control" type="email" placeholder="din@email.dk" @bind="formEmail" />
            </div>
            <div class="form-group">
                <label class="form-label">Virksomhed</label>
                <input class="form-control" type="text" placeholder="Hvad laver din virksomhed?" @bind="formCompany" />
            </div>
            <div class="form-group">
                <label class="form-label">Besked (valgfrit)</label>
                <textarea class="form-control" placeholder="Fortæl os lidt om din situation..." @bind="formMessage"></textarea>
            </div>
            <button class="form-submit" @onclick="SubmitForm">Send besked →</button>
        }
    </div>
</div>

<SiteFooter />

@code {
    private bool formSent = false;
    private string formName = "", formPhone = "", formEmail = "", formCompany = "", formMessage = "";

    private void SubmitForm()
    {
        if (!string.IsNullOrWhiteSpace(formName) && !string.IsNullOrWhiteSpace(formEmail))
            formSent = true;
    }
}
