@page "/google-ads"

<PageTitle>Google Ads – HåndværkerPartner</PageTitle>

<NavBar />

<div class="subpage">
    <div class="subpage-hero" style="background: #1a1a1a;">
        <div class="subpage-hero-inner">
            <p class="hero-badge">Google Ads Bureau</p>
            <h2>Vis dig øverst når kunderne søger</h2>
            <p class="hero-sub">Når en potentiel kunde søger efter en håndværker i dit område, vil vi sikre at det er dig de finder først – ikke konkurrenten.</p>
            <a href="kontakt" class="btn-primary">Anmod om gratis analyse</a>
        </div>
    </div>

    <div class="subpage-content">
        <div class="section-inner">
            <div class="subpage-grid">
                <div class="subpage-text">
                    <span class="section-tag">Google Ads</span>
                    <h2 class="section-title">Annoncering der <span>rammer rigtigt</span></h2>
                    <p class="section-subtitle">Vi opsætter og optimerer Google Ads kampagner der viser sig til folk der aktivt søger efter netop dine ydelser – i det øjeblik de søger.</p>
                    <ul class="about-list" style="margin-top: 24px;">
                        <li><span class="check-icon">✓</span> Søgekampagner målrettet din branche</li>
                        <li><span class="check-icon">✓</span> Lokal targeting så du når de rigtige kunder</li>
                        <li><span class="check-icon">✓</span> Løbende budstyring og optimering</li>
                        <li><span class="check-icon">✓</span> Konverteringssporing så vi ved hvad der virker</li>
                        <li><span class="check-icon">✓</span> Gennemsigtig rapportering hver måned</li>
                    </ul>
                </div>
                <div class="subpage-stats">
                    <div class="result-card-light">
                        <div class="result-card-platform"><span class="platform-badge-light">Google</span></div>
                        <div class="result-client-light">12 måneder med CT Isolering</div>
                        <div class="result-metrics-light">
                            <div class="metric-light"><div class="metric-value">92 kr</div><div class="metric-label-dark">Pris/lead</div></div>
                            <div class="metric-light"><div class="metric-value">967</div><div class="metric-label-dark">Leads</div></div>
                            <div class="metric-light"><div class="metric-value">12 mdr</div><div class="metric-label-dark">Periode</div></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="subpage-cta">
        <h2>Klar til at komme øverst på Google?</h2>
        <p>Book en gratis og uforpligtende samtale i dag.</p>
        <a href="kontakt" class="btn-primary">Kom i gang</a>
    </div>
</div>

<SiteFooter />
