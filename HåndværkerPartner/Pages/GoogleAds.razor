@page "/google-ads"

<PageTitle>Google Ads - HåndværkerPartner</PageTitle>

<NavBar />

<main class="google-hero-page">
    <section class="google-hero">
        <div class="google-hero-inner">
            <h1>
                Bliv fundet af kunder med
                <span>Google annoncer</span>
                lige når de søger efter dit fag.
            </h1>
            <p class="google-sub">
                Vi hjælper håndværkere med at få flere kunder ind fra folk der søger efter dit fag på Google. Det rigtige setup, de rigtige søgeord og løbende justering.
            </p>
            <div class="google-hero-actions">
                <a href="kontakt" class="google-cta">Book uforpligtende samtale</a>
            </div>
        </div>
    </section>

    <section class="google-process-shell" @onmouseleave="ResetActiveProcess">
        <div class="google-process-intro">
            <p class="google-section-label">Sådan gør vi</p>
            <h2>Vi bygger Google Ads som et arbejdsværktøj - ikke bare en konto der kører.</h2>
            <p class="google-summary-title">Google Ads virker bedst når alt fra søgning til kontakt hænger sammen.</p>
            <p>Hvert trin handler om at gøre budgettet og henvendelserne bedre måned for måned.</p>
        </div>

        <div class="google-process">
            <div class="google-process-header">
                <p class="google-process-eyebrow">Fra søgning til kunde</p>
            </div>
            <div class="google-process-track">
                @foreach (var step in processSteps)
                {
                    var isActive = activeProcessStep == step.Number;

                    <button type="button"
                            class="google-process-card @(isActive ? "is-active" : null)"
                            @onmouseover="@(() => SetActiveProcess(step.Number))"
                            aria-expanded="@isActive">
                        <div class="google-process-top">
                            <span class="google-process-number">@step.Number</span>
                        </div>

                        <div class="google-process-head">
                            <h2>@step.Title</h2>
                            <p>@step.Subtitle</p>
                        </div>

                        <div class="google-process-body @(isActive ? "is-active" : null)">
                            <p>@step.Body</p>
                        </div>
                    </button>
                }
            </div>
        </div>
    </section>

    <section class="google-cards-wrap">
        <h2 class="google-cards-headline">
            Det her <span>hjælper</span> vi dig med, i din <span>branche</span>.
        </h2>
    </section>

    <section class="google-cards">
        <div class="google-cards-stage">
            <button type="button" class="google-cards-arrow google-cards-arrow--prev" @onclick="GoPrev" aria-label="Forrige kort" disabled="@(!CanGoPrev)">
                <span>←</span>
            </button>
            <div class="google-cards-viewport">
            <div class="google-cards-track" style="@($"--slide-index:{cardStartIndex};")">
                @foreach (var card in cards)
                {
            <article class="google-card">
                <div class="google-card-icon" aria-hidden="true">
                    @if (card.Icon == "screen")
                    {
                        <svg viewBox="0 0 24 24" fill="none">
                            <rect x="3.5" y="5" width="17" height="14" rx="3"></rect>
                            <line x1="7" y1="10" x2="17" y2="10"></line>
                            <line x1="7" y1="14" x2="13" y2="14"></line>
                        </svg>
                    }
                    else if (card.Icon == "doc")
                    {
                        <svg viewBox="0 0 24 24" fill="none">
                            <rect x="5" y="3.5" width="14" height="17" rx="3"></rect>
                            <line x1="8" y1="9" x2="16" y2="9"></line>
                            <line x1="8" y1="13" x2="16" y2="13"></line>
                        </svg>
                    }
                    else if (card.Icon == "star")
                    {
                        <svg viewBox="0 0 24 24" fill="none">
                            <path d="M12 4.5l2.2 4.4 4.8.7-3.5 3.4.8 4.9L12 15.7 7.7 18l.8-4.9L5 9.6l4.8-.7L12 4.5z"></path>
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" fill="none">
                            <rect x="3.5" y="3.5" width="7" height="7" rx="2"></rect>
                            <rect x="13.5" y="3.5" width="7" height="7" rx="2"></rect>
                            <rect x="8.5" y="13.5" width="7" height="7" rx="2"></rect>
                            <line x1="10.5" y1="7" x2="13.5" y2="7"></line>
                            <line x1="12" y1="10.5" x2="12" y2="13.5"></line>
                        </svg>
                    }
                </div>
                <h2>@card.Title</h2>
                <p>@card.Body</p>
            </article>
                }
            </div>
            </div>
            <button type="button" class="google-cards-arrow google-cards-arrow--next" @onclick="GoNext" aria-label="Næste kort" disabled="@(!CanGoNext)">
                <span>→</span>
            </button>
        </div>
    </section>

    <section class="google-faq">
        <div class="google-faq-intro">
            <h2>Spørgsmål og svar</h2>
            <p>
                Her finder du svar på det vi oftest bliver spurgt om: hvordan vi sætter Google Ads op, hvordan vi arbejder og hvordan vi får mere ud af pengene.
                Vi holder det kort, så du hurtigt kan se hvad der er værd at vide.
            </p>
        </div>

        <div class="google-faq-list">
            <details class="faq-item">
                <summary><span class="faq-title">Hvorfor lade andre stå for Google Ads?</span></summary>
                <p>Du undgår dyre fejl, vi lærer hurtigere af tallene, og pengene bliver brugt på de søgninger der faktisk skaffer opgaver.</p>
            </details>
            <details class="faq-item">
                <summary><span class="faq-title">Hvordan finder I de rigtige søgeord?</span></summary>
                <p>Vi kigger på dine ydelser, hvor du arbejder og hvad konkurrenterne gør, og vælger søgeord folk bruger når de er klar til at hyre en håndværker.</p>
            </details>
            <details class="faq-item">
                <summary><span class="faq-title">Hvordan forbedrer I resultaterne over tid?</span></summary>
                <p>Vi tester nye annoncer, justerer hvad vi byder på søgeordene, og fjerner søgninger der ikke giver opgaver, så det bliver bedre måned for måned.</p>
            </details>
            <details class="faq-item">
                <summary><span class="faq-title">Hvad får jeg at vide om resultaterne?</span></summary>
                <p>Du får klare tal på klik, henvendelser, pris pr. henvendelse og hvad du får ud af pengene - og en snak om hvad vi gør herefter.</p>
            </details>
        </div>
    </section>

</main>

<ProductPageCta />
<SiteFooter />

@code {
    private const int CardsPerPage = 2;
    private int cardStartIndex = 0;
    private string activeProcessStep = "01";

    private readonly List<ProcessStep> processSteps =
    [
        new("01", "Snak", "Dine ydelser, område og mål", "Vi starter med at finde ud af hvilke opgaver du helst vil have ind, og i hvilke områder. Så ved vi hvilke søgninger der er vigtige for dig, og hvilke vi skal sortere fra."),
        new("02", "Vurdering", "Hvor er der kunder at hente", "Vi vurderer hvor mange der søger efter dit fag, hvor mange du står overfor, og hvad det koster. Du får en ærlig melding om hvor Google Ads kan give hurtig effekt, og hvor det kræver lidt mere tid."),
        new("03", "Opsætning", "Søgeord, annoncer og side", "Vi bygger annoncerne op med søgeord, annoncetekster og den side folk lander på, så det hele hænger sammen. Det gør kontoen nemmere at styre og giver flere kunder for pengene."),
        new("04", "Justering", "Søgeord, bud og kvalitet", "Når annoncerne kører, retter vi løbende til på søgeord, bud og annoncer. Målet er at bruge dine penge bedre og få flere af de henvendelser du faktisk kan bruge."),
        new("05", "Snak igen", "Tal og næste skridt", "Du får ikke bare tal på klik og forbrug - du får konkrete anbefalinger til hvad vi gør herefter. På den måde bliver Google Ads en del af væksten, ikke bare en konto der kører i baggrunden.")
    ];

    private readonly List<ServiceCard> cards =
    [
        new("screen", "Søgeord folk bruger når de skal hyre", "Vi vælger søgeord der rammer kunder der er klar til at tage fat i en håndværker, så pengene ikke bliver brugt på folk der bare kigger."),
        new("doc", "Annoncer der får folk til at klikke", "Vi skriver annoncetekster der gør det tydeligt hvad du tilbyder, så din virksomhed står stærkest i søgeresultatet."),
        new("star", "En side hvor kunder faktisk tager fat", "Vi sørger for at folk lander på en side hvor det er nemt at ringe eller udfylde en formular."),
        new("grid", "Vi forbedrer budgettet løbende", "Vi justerer søgeord, bud og opsætning hele tiden, så prisen pr. henvendelse falder og flere kroner bliver til opgaver.")
    ];

    private int MaxSlideIndex => Math.Max(0, cards.Count - CardsPerPage);
    private bool CanGoPrev => cardStartIndex > 0;
    private bool CanGoNext => cardStartIndex < MaxSlideIndex;

    private void SetActiveProcess(string number) => activeProcessStep = number;
    private void ResetActiveProcess() => activeProcessStep = "01";

    private void GoNext()
    {
        if (CanGoNext) cardStartIndex++;
    }

    private void GoPrev()
    {
        if (CanGoPrev) cardStartIndex--;
    }

    private sealed record ServiceCard(string Icon, string Title, string Body);
    private sealed record ProcessStep(string Number, string Title, string Subtitle, string Body);
}
