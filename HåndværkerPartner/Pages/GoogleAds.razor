@page "/google-ads"

<PageTitle>Google Ads – HåndværkerPartner</PageTitle>

<NavBar />

<main class="google-hero-page">
    <section class="google-hero">
        <div class="google-hero-inner">
            <p class="google-label">GOOGLE ADS</p>
            <h1>
                Bliv fundet af kunder med
                <span>Google annoncer</span>
                der er klar til at købe nu.
            </h1>
            <p class="google-sub">
                Vi hjælper håndværksvirksomheder med at omsætte søgninger til kvalificerede henvendelser gennem skarp struktur, præcise søgeord og løbende optimering.
            </p>
            <div class="google-hero-actions">
                <a href="kontakt" class="google-cta">Book uforpligtende samtale</a>
            </div>
        </div>
    </section>

    <section class="google-process-shell" @onmouseleave="ResetActiveProcess">
        <div class="google-process-intro">
            <p class="google-section-label">Process</p>
            <h2>Vi bygger Google Ads som et arbejdsværktøj, ikke bare en konto der kører.</h2>
            <p class="google-summary-title">Google Ads giver mest værdi, når hele vejen fra søgning til kontakt hænger sammen.</p>
            <p>Hvert trin handler om at gøre budget, søgninger og henvendelser mere præcise måned for måned.</p>
        </div>

        <div class="google-process">
            <div class="google-process-header">
                <p class="google-process-eyebrow">Fra søgning til booking</p>
            </div>
            <div class="google-process-track">
                @foreach (var step in processSteps)
                {
                    var isActive = activeProcessStep == step.Number;

                    <button type="button"
                            class="google-process-card @(isActive ? "is-active" : null)"
                            @onmouseover="@(() => SetActiveProcess(step.Number))"
                            aria-expanded="@isActive">
                        <div class="google-process-top">
                            <span class="google-process-number">@step.Number</span>
                        </div>

                        <div class="google-process-head">
                            <h2>@step.Title</h2>
                            <p>@step.Subtitle</p>
                        </div>

                        <div class="google-process-body @(isActive ? "is-active" : null)">
                            <p>@step.Body</p>
                        </div>
                    </button>
                }
            </div>
        </div>
    </section>

    <section class="google-cards-wrap">
        <h2 class="google-cards-headline">
            Det her <span>hjælper</span> vi dig med, i din <span>branche</span>.
        </h2>
        <div class="google-cards-controls">
            @if (CanGoPrev)
            {
                <button type="button" class="google-cards-arrow" @onclick="GoPrev" aria-label="Forrige kort">
                    <span>←</span>
                </button>
            }
            <button type="button" class="google-cards-arrow" @onclick="GoNext" aria-label="Næste kort" disabled="@(!CanGoNext)">
                <span>→</span>
            </button>
        </div>
    </section>

    <section class="google-cards">
        <div class="google-cards-viewport">
            <div class="google-cards-track" style="@($"--slide-index:{cardStartIndex};")">
                @foreach (var card in cards)
                {
            <article class="google-card">
                <div class="google-card-icon" aria-hidden="true">
                    @if (card.Icon == "screen")
                    {
                        <svg viewBox="0 0 24 24" fill="none">
                            <rect x="3.5" y="5" width="17" height="14" rx="3"></rect>
                            <line x1="7" y1="10" x2="17" y2="10"></line>
                            <line x1="7" y1="14" x2="13" y2="14"></line>
                        </svg>
                    }
                    else if (card.Icon == "doc")
                    {
                        <svg viewBox="0 0 24 24" fill="none">
                            <rect x="5" y="3.5" width="14" height="17" rx="3"></rect>
                            <line x1="8" y1="9" x2="16" y2="9"></line>
                            <line x1="8" y1="13" x2="16" y2="13"></line>
                        </svg>
                    }
                    else if (card.Icon == "star")
                    {
                        <svg viewBox="0 0 24 24" fill="none">
                            <path d="M12 4.5l2.2 4.4 4.8.7-3.5 3.4.8 4.9L12 15.7 7.7 18l.8-4.9L5 9.6l4.8-.7L12 4.5z"></path>
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" fill="none">
                            <rect x="3.5" y="3.5" width="7" height="7" rx="2"></rect>
                            <rect x="13.5" y="3.5" width="7" height="7" rx="2"></rect>
                            <rect x="8.5" y="13.5" width="7" height="7" rx="2"></rect>
                            <line x1="10.5" y1="7" x2="13.5" y2="7"></line>
                            <line x1="12" y1="10.5" x2="12" y2="13.5"></line>
                        </svg>
                    }
                </div>
                <h2>@card.Title</h2>
                <p>@card.Body</p>
            </article>
                }
            </div>
        </div>
    </section>

    <section class="google-faq">
        <div class="google-faq-intro">
            <h2>FAQ</h2>
            <p>
                Her finder du de vigtigste svar om vores Google Ads-opsætning, proces og optimering.
                Vi holder det konkret, så du hurtigt kan se, hvad der giver værdi i praksis.
            </p>
        </div>

        <div class="google-faq-list">
            <details class="faq-item">
                <summary><span class="faq-title">Hvorfor vælge professionel Google Ads-håndtering?</span></summary>
                <p>Du undgår dyre fejl, får hurtigere læring fra data og en skarpere prioritering af budgettet mod de søgninger, der skaber opgaver.</p>
            </details>
            <details class="faq-item">
                <summary><span class="faq-title">Hvordan finder I de rigtige søgeord?</span></summary>
                <p>Vi analyserer dine ydelser, lokalområder og konkurrence og udvælger søgeord med høj intention frem for bred, dyr trafik.</p>
            </details>
            <details class="faq-item">
                <summary><span class="faq-title">Hvordan forbedrer I resultaterne over tid?</span></summary>
                <p>Vi tester annoncer, justerer budstrategier og renser løbende søgetermer, så kampagnen bliver mere effektiv måned for måned.</p>
            </details>
            <details class="faq-item">
                <summary><span class="faq-title">Hvad måler I på i rapporteringen?</span></summary>
                <p>Vi fokuserer på klikrate, konverteringsrate, pris pr. lead og samlet afkast, så du får klare beslutninger baseret på performance.</p>
            </details>
        </div>
    </section>

</main>

<ProductPageCta />
<SiteFooter />

@code {
    private const int CardsPerPage = 2;
    private int cardStartIndex = 0;
    private string activeProcessStep = "01";

    private readonly List<ProcessStep> processSteps =
    [
        new("01", "Afdækning", "Ydelser, geografi og mål", "Vi starter med at kortlægge dine vigtigste ydelser, lokalområder og hvilken type opgaver du helst vil have flere af. Det giver os retning på, hvilke søgninger der er forretningskritiske, og hvilke der bør sorteres fra."),
        new("02", "Vurdering", "Potentiale og købssignaler", "Herefter vurderer vi søgeintention, konkurrencesituation og budgetmuligheder. Du får en konkret vurdering af, hvor Google Ads kan skabe hurtig værdi, og hvor indsatsen kræver en mere langsigtet tilgang."),
        new("03", "Struktur", "Søgeord, annoncer og landing pages", "Vi bygger en skarp kampagnestruktur med søgeord, annoncer og destinationssider, der hænger logisk sammen. Det gør kontoen lettere at styre, lettere at optimere og stærkere i forhold til både kvalitetsscore og konvertering."),
        new("04", "Optimering", "Søgetermer, bud og kvalitet", "Når kampagnerne er live, arbejder vi løbende med søgetermer, budstrategier, annoncevarianter og negativ match. Målet er at bruge budgettet mere præcist og løfte kvaliteten af de henvendelser, du får ind."),
        new("05", "Sparring", "Rapportering og næste skridt", "Du får ikke bare et overblik over klik og spend, men konkrete anbefalinger til næste skridt. På den måde bliver Google Ads en aktiv del af din vækst, ikke bare en konto der kører i baggrunden.")
    ];

    private readonly List<ServiceCard> cards =
    [
        new("screen", "Søgeord med høj købsintention", "Vi vælger søgeord, der matcher konkrete behov her og nu, så budgettet bruges på kunder, der faktisk er tæt på at tage kontakt."),
        new("doc", "Annoncer, der vinder klikket", "Vi skriver annoncetekster med tydelig værdi, så din virksomhed fremstår mere relevant og troværdig i søgeresultatet."),
        new("star", "Landing pages der konverterer", "Vi sikrer, at besøgende lander på en side, der gør næste skridt enkelt og øger chancen for opkald eller formular."),
        new("grid", "Løbende optimering af budget", "Vi justerer søgetermer, bud og struktur løbende, så prisen pr. lead forbedres og flere annoncekroner omsættes til reel forretning.")
    ];

    private int MaxSlideIndex => Math.Max(0, cards.Count - CardsPerPage);
    private bool CanGoPrev => cardStartIndex > 0;
    private bool CanGoNext => cardStartIndex < MaxSlideIndex;

    private void SetActiveProcess(string number) => activeProcessStep = number;
    private void ResetActiveProcess() => activeProcessStep = "01";

    private void GoNext()
    {
        if (CanGoNext) cardStartIndex++;
    }

    private void GoPrev()
    {
        if (CanGoPrev) cardStartIndex--;
    }

    private sealed record ServiceCard(string Icon, string Title, string Body);
    private sealed record ProcessStep(string Number, string Title, string Subtitle, string Body);
}
