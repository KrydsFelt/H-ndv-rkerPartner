@page "/meta"

<PageTitle>Meta Ads – HåndværkerPartner</PageTitle>

<NavBar />

<main class="meta-hero-page">
    <section class="meta-hero">
        <div class="meta-hero-inner">
            <h1>
                Få flere kunder med
                <span>annoncer</span>
                på Facebook og Instagram.
            </h1>
            <p class="meta-sub">
                Vi hjælper håndværkere med at få flere kunder ind. Vi rammer de rigtige folk med de rigtige annoncer – og laver en plan der virker i længden.
            </p>
            <div class="meta-hero-actions">
                <a href="kontakt" class="meta-cta">Book uforpligtende samtale</a>
            </div>
        </div>
    </section>

    <section class="meta-process">
        <div class="meta-process-header">
            <p class="meta-process-eyebrow">Process</p>
        </div>
        <div class="meta-process-track">
            @foreach (var step in processSteps)
            {
                <article class="meta-process-card">
                    <div class="meta-process-top">
                        <span class="meta-process-number">@step.Number</span>
                        <span class="meta-process-dot" aria-hidden="true"></span>
                    </div>

                    <div class="meta-process-head">
                        <h2>@step.Title</h2>
                        <p>@step.Subtitle</p>
                    </div>

                    <div class="meta-process-body">
                        <p>@step.Body</p>
                    </div>
                </article>
            }
        </div>
    </section>

    <section class="meta-kpi-section">
        <div class="meta-kpi-grid">
            <article class="meta-kpi-card">
                <div class="meta-kpi-value">33 kr.</div>
                <div class="meta-kpi-label">Laveste pris pr. henvendelse</div>
            </article>
            <article class="meta-kpi-card">
                <div class="meta-kpi-value">+1.000</div>
                <div class="meta-kpi-label">Henvendelser skaffet</div>
            </article>
            <article class="meta-kpi-card">
                <div class="meta-kpi-value">0 dages</div>
                <div class="meta-kpi-label">Binding</div>
            </article>
            <article class="meta-kpi-card">
                <div class="meta-kpi-value">&gt;24 t</div>
                <div class="meta-kpi-label">Typisk svartid</div>
            </article>
        </div>
    </section>

    <section class="meta-story">
        <div class="meta-story-row">
            <div class="meta-story-copy">
                <p class="meta-story-eyebrow">Kort fortalt</p>
                <h2>Du skal kunne mærke det i kalenderen. Ikke kun i en rapport.</h2>
                <p class="meta-story-lead">Vi gør det nemt at forstå og nemt at følge med i. Det handler om én ting: flere henvendelser til en fornuftig pris.</p>
                <ul class="meta-story-points">
                    <li>Vi vælger budskaber der passer til de opgaver du gerne vil have ind.</li>
                    <li>Vi tester løbende og skruer ned for det der ikke virker.</li>
                    <li>Du får klar besked uden marketing-snak og unødigt fyld.</li>
                </ul>
            </div>
            <div class="meta-story-media">
                <div class="meta-story-visual" aria-hidden="true">
                    <div class="meta-story-orbit meta-story-orbit--one"></div>
                    <div class="meta-story-orbit meta-story-orbit--two"></div>

                    <div class="meta-story-calendar">
                        <div class="meta-story-calendar-top">
                            <span class="meta-story-calendar-ring"></span>
                            <span class="meta-story-calendar-ring"></span>
                        </div>

                        <div class="meta-story-calendar-grid">
                            @for (var i = 0; i < 15; i++)
                            {
                                var cellClass = i == 6 ? "meta-story-calendar-cell is-focus" : "meta-story-calendar-cell";
                                <span class="@cellClass"></span>
                            }
                        </div>

                        <div class="meta-story-calendar-sheet">
                            <span class="meta-story-calendar-line meta-story-calendar-line--short"></span>
                            <span class="meta-story-calendar-line"></span>
                            <span class="meta-story-calendar-line meta-story-calendar-line--mid"></span>
                            <span class="meta-story-calendar-line"></span>
                        </div>
                    </div>

                    <div class="meta-story-card meta-story-card--lead">
                        <span class="meta-story-card-label">Leadpris</span>
                        <strong>Fra 33 kr.</strong>
                    </div>

                    <div class="meta-story-task-card">
                        <div class="meta-story-task-list">
                            <span class="meta-story-task-line meta-story-task-line--short"></span>
                            <span class="meta-story-task-line"></span>
                            <span class="meta-story-task-line meta-story-task-line--mid"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="meta-cards-wrap">
        <h2 class="meta-cards-headline">
            Det her <span>hjælper</span> vi dig med, i din <span>branche</span>.
        </h2>
    </section>

    <section class="meta-cards">
        <div class="meta-cards-viewport">
            <div class="meta-cards-track" style="@($"--slide-index:{cardStartIndex};")">
                @foreach (var card in cards)
                {
                    <article class="meta-card">
                        <div class="meta-card-icon" aria-hidden="true">
                            @if (card.Icon == "screen")
                            {
                                <svg viewBox="0 0 24 24" fill="none">
                                    <rect x="3.5" y="5" width="17" height="14" rx="3"></rect>
                                    <line x1="7" y1="10" x2="17" y2="10"></line>
                                    <line x1="7" y1="14" x2="13" y2="14"></line>
                                </svg>
                            }
                            else if (card.Icon == "doc")
                            {
                                <svg viewBox="0 0 24 24" fill="none">
                                    <rect x="5" y="3.5" width="14" height="17" rx="3"></rect>
                                    <line x1="8" y1="9" x2="16" y2="9"></line>
                                    <line x1="8" y1="13" x2="16" y2="13"></line>
                                </svg>
                            }
                            else if (card.Icon == "star")
                            {
                                <svg viewBox="0 0 24 24" fill="none">
                                    <path d="M12 4.5l2.2 4.4 4.8.7-3.5 3.4.8 4.9L12 15.7 7.7 18l.8-4.9L5 9.6l4.8-.7L12 4.5z"></path>
                                </svg>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" fill="none">
                                    <rect x="3.5" y="3.5" width="7" height="7" rx="2"></rect>
                                    <rect x="13.5" y="3.5" width="7" height="7" rx="2"></rect>
                                    <rect x="8.5" y="13.5" width="7" height="7" rx="2"></rect>
                                    <line x1="10.5" y1="7" x2="13.5" y2="7"></line>
                                    <line x1="12" y1="10.5" x2="12" y2="13.5"></line>
                                </svg>
                            }
                        </div>
                        <h2>@card.Title</h2>
                        <p>@card.Body</p>
                    </article>
                }
            </div>
        </div>
        <div class="meta-cards-controls">
            <button type="button" class="meta-cards-arrow" @onclick="GoPrev" aria-label="Forrige kort" disabled="@(!CanGoPrev)">
                <span>←</span>
            </button>
            <button type="button" class="meta-cards-arrow" @onclick="GoNext" aria-label="Næste kort" disabled="@(!CanGoNext)">
                <span>→</span>
            </button>
        </div>
    </section>

    <section class="meta-faq">
        <div class="meta-faq-intro">
            <h2>Spørgsmål og svar</h2>
            <p>
                Her finder du svar på det vi oftest bliver spurgt om: hvordan vi sætter annoncerne op, hvordan vi arbejder og hvordan vi får mere ud af pengene.
                Vi holder det kort, så du hurtigt kan se om det er noget for dig.
            </p>
        </div>

        <div class="meta-faq-list">
            <details class="faq-item">
                <summary>
                    <span class="faq-title">Hvorfor lade andre stå for Meta Ads?</span>
                </summary>
                <p>
                    Vi sørger for at pengene bliver brugt rigtigt, lærer hurtigere af tallene og undgår dyre fejl.
                    Det betyder typisk bedre henvendelser og mere stabile resultater måned for måned.
                </p>
            </details>

            <details class="faq-item">
                <summary>
                    <span class="faq-title">Hvordan sikrer I, at I rammer de rigtige kunder?</span>
                </summary>
                <p>
                    Vi starter med dit mål, hvor meget du kan tage ind, og hvilke kunder du gerne vil have.
                    Så laver vi annoncer til forskellige grupper og tester hvad der virker bedst.
                </p>
            </details>

            <details class="faq-item">
                <summary>
                    <span class="faq-title">Hvordan laver I annoncer der virker?</span>
                </summary>
                <p>
                    Vi laver annoncerne ud fra hvad dine kunder tænker når de skal vælge en håndværker.
                    Vi prøver flere udgaver af hver annonce, så vi kan se hvad der får flest til at klikke og tage fat i dig.
                </p>
            </details>

            <details class="faq-item">
                <summary>
                    <span class="faq-title">Hvordan måler og forbedrer I det løbende?</span>
                </summary>
                <p>
                    Vi holder øje med pris pr. henvendelse, hvor mange der klikker, og hvad du får ud af pengene.
                    Ud fra det justerer vi budget, målgrupper og annoncer, så det bliver bedre uge for uge.
                </p>
            </details>
        </div>
    </section>

</main>

<ProductPageCta />
<SiteFooter />

@code {
    private const int CardsPerPage = 2;
    private int cardStartIndex = 0;
    private readonly List<ProcessStep> processSteps =
    [
        new("01", "Snak", "Din virksomhed, mål og behov", "Vi starter med at høre om din virksomhed, hvilke opgaver du gerne vil have mere af, og hvad der virker for dig i dag. Så ved vi præcis hvad du har brug for, før vi anbefaler noget."),
        new("02", "Vurdering", "Hvad giver mening for dig", "Vi bruger vores erfaring fra håndværkerbranchen til at vurdere hvor mange kunder du kan få, hvem vi skal ramme, og hvad det koster. Du får en ærlig vurdering af hvad der giver mening at gå i gang med nu."),
        new("03", "Plan", "Budskab, målgruppe og opsætning", "Når vi ved hvad vi vil, laver vi en plan for hvordan annoncerne skal se ud, hvad de skal sige, og hvem de skal vises for. Vi går efter rigtige henvendelser – ikke bare tal der ser pæne ud i en rapport."),
        new("04", "Justering", "Vi forbedrer det løbende", "Når annoncerne kører, holder vi øje med dem og justerer på budskaber, målgrupper og budget. Målet er at dine penge bliver brugt bedre over tid, så du kan mærke det på antallet af opgaver."),
        new("05", "Snak igen", "Tal og næste skridt", "Du får ikke bare tal, men en snak om hvad de betyder og hvad vi gør herefter. På den måde hænger det vi laver sammen med din hverdag og det du vil opnå.")
    ];

    private readonly List<ServiceCard> cards =
    [
        new("screen", "Hvad er Meta Ads, og hvorfor virker det?", "Meta Ads er annoncer på Facebook og Instagram, hvor vi bestemmer hvem der ser dem, og hvad de siger. På den måde rammer vi både nye kunder og folk der allerede har hørt om dig. For dig betyder det at flere ser dig, og at der kommer flere henvendelser ind."),
        new("doc", "Annoncer der er bygget til at virke", "Vi sætter annoncerne op med et tydeligt mål fra start, så de leder folk det rigtige sted hen. Vi kan altid skrue op, teste nyt og forbedre det undervejs. Det handler om at få folk til at tage fat i dig – ikke bare at blive set."),
        new("star", "Annoncer der fanger folk", "Annoncer virker først når budskabet er klart. Derfor laver vi annoncer der gør dit tilbud nemt at forstå og svært at scrolle forbi. Klar tekst, gode billeder og en tydelig knap gør at folk både stopper op og tager fat i dig."),
        new("grid", "Vi forbedrer det løbende", "Når annoncerne kører, holder vi øje med tallene og retter hurtigt til på målgrupper, budget og budskaber. Vi arbejder med det der faktisk skaffer kunder, så pengene bliver brugt bedre måned for måned. Du får klare tal og klare anbefalinger.")
    ];

    private int MaxSlideIndex => Math.Max(0, cards.Count - CardsPerPage);
    private bool CanGoPrev => cardStartIndex > 0;
    private bool CanGoNext => cardStartIndex < MaxSlideIndex;

    private void GoNext()
    {
        if (CanGoNext)
        {
            cardStartIndex++;
        }
    }

    private void GoPrev()
    {
        if (CanGoPrev)
        {
            cardStartIndex--;
        }
    }

    private sealed record ServiceCard(string Icon, string Title, string Body);
    private sealed record ProcessStep(string Number, string Title, string Subtitle, string Body);
}
