@page "/meta"

<PageTitle>Meta Ads – HåndværkerPartner</PageTitle>

<NavBar />

<main class="meta-hero-page">
    <section class="meta-hero">
        <div class="meta-hero-inner">
            <p class="meta-label">META ADS</p>
            <h1>
                Få mere ud af dine kanaler med
                <span>Meta annoncer</span>
                der skaber interesse og konkrete henvendelser.
            </h1>
            <p class="meta-sub">
                Vi hjælper håndværksvirksomheder med at tiltrække relevante kunder gennem præcis målretning, stærk kommunikation og en plan, der er bygget til stabile resultater.
            </p>
            <div class="meta-hero-actions">
                <a href="kontakt" class="meta-cta">Book en gratis Meta-gennemgang</a>
            </div>
        </div>
    </section>

    <section class="meta-cards-wrap">
        <h2 class="meta-cards-headline">
            Det her <span>hjælper</span> vi dig med, i din <span>branche</span>.
        </h2>
        <div class="meta-cards-controls">
            @if (CanGoPrev)
            {
                <button type="button" class="meta-cards-arrow" @onclick="GoPrev" aria-label="Forrige kort">
                    <span>←</span>
                </button>
            }
            <button type="button" class="meta-cards-arrow" @onclick="GoNext" aria-label="Næste kort" disabled="@(!CanGoNext)">
                <span>→</span>
            </button>
        </div>
    </section>

    <section class="meta-cards">
        <div class="meta-cards-viewport">
            <div class="meta-cards-track" style="@($"--slide-index:{cardStartIndex};")">
                @foreach (var card in cards)
                {
            <article class="meta-card">
                <div class="meta-card-icon" aria-hidden="true">
                    @if (card.Icon == "screen")
                    {
                        <svg viewBox="0 0 24 24" fill="none">
                            <rect x="3.5" y="5" width="17" height="14" rx="3"></rect>
                            <line x1="7" y1="10" x2="17" y2="10"></line>
                            <line x1="7" y1="14" x2="13" y2="14"></line>
                        </svg>
                    }
                    else if (card.Icon == "doc")
                    {
                        <svg viewBox="0 0 24 24" fill="none">
                            <rect x="5" y="3.5" width="14" height="17" rx="3"></rect>
                            <line x1="8" y1="9" x2="16" y2="9"></line>
                            <line x1="8" y1="13" x2="16" y2="13"></line>
                        </svg>
                    }
                    else if (card.Icon == "star")
                    {
                        <svg viewBox="0 0 24 24" fill="none">
                            <path d="M12 4.5l2.2 4.4 4.8.7-3.5 3.4.8 4.9L12 15.7 7.7 18l.8-4.9L5 9.6l4.8-.7L12 4.5z"></path>
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" fill="none">
                            <rect x="3.5" y="3.5" width="7" height="7" rx="2"></rect>
                            <rect x="13.5" y="3.5" width="7" height="7" rx="2"></rect>
                            <rect x="8.5" y="13.5" width="7" height="7" rx="2"></rect>
                            <line x1="10.5" y1="7" x2="13.5" y2="7"></line>
                            <line x1="12" y1="10.5" x2="12" y2="13.5"></line>
                        </svg>
                    }
                </div>
                <h2>@card.Title</h2>
                <p>@card.Body</p>
            </article>
                }
            </div>
        </div>
    </section>

    <section class="meta-faq">
        <div class="meta-faq-intro">
            <h2>FAQ</h2>
            <p>
                Her finder du de vigtigste svar om vores Meta Ads-setup, arbejdsmetode og optimering.
                Vi holder det konkret, så du hurtigt kan vurdere, om løsningen passer til din virksomhed.
            </p>
        </div>

        <div class="meta-faq-list">
            <details class="faq-item">
                <summary>
                    <span class="faq-title">Hvorfor vælge professionel Meta Ads-håndtering?</span>
                </summary>
                <p>
                    Professionel håndtering giver bedre prioritering af budget, hurtigere læring fra data og færre dyre fejl i opsætningen.
                    Det betyder typisk højere kvalitet i leads og mere stabile resultater måned for måned.
                </p>
            </details>

            <details class="faq-item">
                <summary>
                    <span class="faq-title">Hvordan sikrer I, at kampagnerne rammer rigtigt?</span>
                </summary>
                <p>
                    Vi starter med dit mål, din kapacitet og din ideelle kundeprofil. Herefter bygger vi kampagner med klare segmenter og
                    tester variationer systematisk, så vi kan forstærke det, der performer bedst.
                </p>
            </details>

            <details class="faq-item">
                <summary>
                    <span class="faq-title">Hvordan laver I annoncer, der konverterer?</span>
                </summary>
                <p>
                    Vi udvikler budskaber ud fra kundens behov og beslutningsproces, og vi matcher format og vinkel til platformen.
                    Hver annonce testes i flere versioner, så vi kan løfte CTR, relevans og konvertering med reel dokumentation.
                </p>
            </details>

            <details class="faq-item">
                <summary>
                    <span class="faq-title">Hvordan måler og forbedrer I resultaterne løbende?</span>
                </summary>
                <p>
                    Vi følger KPI'er som pris pr. lead, klikrate, konverteringsrate og samlet afkast. På baggrund af data justerer vi
                    budget, målgrupper og kreativ retning løbende, så indsatsen bliver skarpere for hver uge.
                </p>
            </details>
        </div>
    </section>
</main>

<SiteFooter />

@code {
    private const int CardsPerPage = 2;
    private int cardStartIndex = 0;

    private readonly List<ServiceCard> cards =
    [
        new("screen", "Hvad er Meta Ads, og hvorfor virker det?", "Meta Ads er annoncer på Facebook og Instagram, hvor vi styrer målretning, budskab og kreativ retning ned i detaljen. Det gør det muligt at ramme både nye potentielle kunder og varme målgrupper med relevant indhold på det rigtige tidspunkt. For dig betyder det mere stabil synlighed, lavere spild og et bedre flow af henvendelser."),
        new("doc", "Kampagner bygget til performance", "Vi opsætter kampagner med tydelige mål fra start, så hvert trin i kunderejsen har en funktion. Strukturen designes til at kunne skaleres, testes og forbedres løbende uden at miste retning. Resultatet er en kampagne, der er bygget til handling frem for bare rækkevidde."),
        new("star", "Annoncer, der fanger og overbeviser", "God performance starter med stærk kommunikation. Derfor udvikler vi annoncevinkler, der gør dit tilbud let at forstå og svært at ignorere i feedet. Vi kombinerer klar copy, skarpe visuelle valg og tydelige CTA'er, så annoncerne både bliver set og omsat til klik og henvendelser."),
        new("grid", "Løbende optimering med fokus på bundlinje", "Når kampagnen er live, følger vi data tæt og justerer hurtigt på målgrupper, budgetter og budskaber. Vi arbejder systematisk med det, der faktisk flytter resultater, så dine annoncekroner arbejder mere effektivt over tid. Du får klar rapportering og konkrete beslutninger baseret på performance.")
    ];

    private int MaxSlideIndex => Math.Max(0, cards.Count - CardsPerPage);
    private bool CanGoPrev => cardStartIndex > 0;
    private bool CanGoNext => cardStartIndex < MaxSlideIndex;

    private void GoNext()
    {
        if (CanGoNext)
        {
            cardStartIndex++;
        }
    }

    private void GoPrev()
    {
        if (CanGoPrev)
        {
            cardStartIndex--;
        }
    }

    private sealed record ServiceCard(string Icon, string Title, string Body);
}
