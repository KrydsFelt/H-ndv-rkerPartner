@page "/facebook-instagram"

<PageTitle>Facebook / Instagram – HåndværkerPartner</PageTitle>

<NavBar />

<div class="subpage">
    <div class="subpage-hero" style="background-image: linear-gradient(160deg, #1a2e2a 0%, #0f1916 100%);">
        <div class="subpage-hero-inner">
            <p class="hero-badge">Facebook / Instagram Bureau</p>
            <h1>Skab engagerende og mærkbare Facebook kampagner</h1>
            <p class="hero-sub">Dine konkurrenter og kunder er allerede aktive på Meta-platformene. Vi hjælper dig med at nå dem præcist – med annoncering der konverterer.</p>
            <a href="kontakt" class="btn-primary">Anmod om gratis analyse</a>
        </div>
    </div>

    <div class="subpage-content">
        <div class="section-inner">
            <div class="subpage-grid">
                <div class="subpage-text">
                    <span class="section-tag">Hvad vi tilbyder</span>
                    <h2 class="section-title">Meta-annoncering der <span>skaber leads</span></h2>
                    <p class="section-subtitle">Vi planlægger, opsætter og optimerer dine Facebook og Instagram kampagner løbende – så du altid får mest muligt ud af dit budget.</p>
                    <ul class="about-list" style="margin-top: 24px;">
                        <li><span class="check-icon">✓</span> Målrettet leadgenerering til håndværkere</li>
                        <li><span class="check-icon">✓</span> Kreative annoncer der stopper scrollet</li>
                        <li><span class="check-icon">✓</span> Løbende A/B-test og optimering</li>
                        <li><span class="check-icon">✓</span> Månedlig rapportering med klare tal</li>
                        <li><span class="check-icon">✓</span> Ingen binding – vi beholder dig med resultater</li>
                    </ul>
                </div>
                <div class="subpage-stats">
                    <div class="result-card-light">
                        <div class="result-card-platform"><span class="platform-badge-light">Meta</span></div>
                        <div class="result-client-light">10 måneder med Mpuds.dk</div>
                        <div class="result-metrics-light">
                            <div class="metric-light"><div class="metric-value">33 kr</div><div class="metric-label-dark">Leadpris</div></div>
                            <div class="metric-light"><div class="metric-value">613</div><div class="metric-label-dark">Leads</div></div>
                            <div class="metric-light"><div class="metric-value">101 kr</div><div class="metric-label-dark">Pris/kunde</div></div>
                        </div>
                    </div>
                    <div class="result-card-light">
                        <div class="result-card-platform"><span class="platform-badge-light">Meta</span></div>
                        <div class="result-client-light">6 måneder med Nord Polering</div>
                        <div class="result-metrics-light">
                            <div class="metric-light"><div class="metric-value">54,5 kr</div><div class="metric-label-dark">Leadpris</div></div>
                            <div class="metric-light"><div class="metric-value">400</div><div class="metric-label-dark">Leads</div></div>
                            <div class="metric-light"><div class="metric-value">6 mdr</div><div class="metric-label-dark">Periode</div></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="subpage-cta">
        <h2>Klar til flere leads fra Facebook?</h2>
        <p>Book en gratis og uforpligtende samtale i dag.</p>
        <a href="kontakt" class="btn-primary">Kom i gang</a>
    </div>
</div>

<SiteFooter />
