@page "/webudvikling"

<PageTitle>Webudvikling – HåndværkerPartner</PageTitle>

<NavBar />

<div class="subpage">
    <div class="subpage-hero" style="background: #1a1a1a;">
        <div class="subpage-hero-inner">
            <p class="hero-badge">Webudvikling</p>
            <h2>En hjemmeside der sælger for dig</h2>
            <p class="hero-sub">Vi bygger professionelle, hurtige og konverterende hjemmesider til håndværksvirksomheder – der ser godt ud og skaber resultater.</p>
            <a href="kontakt" class="btn-primary">Anmod om gratis analyse</a>
        </div>
    </div>

    <div class="subpage-content">
        <div class="section-inner">
            <div class="subpage-grid">
                <div class="subpage-text">
                    <span class="section-tag">Hjemmesider til håndværkere</span>
                    <h2 class="section-title">Design der <span>konverterer</span></h2>
                    <p class="section-subtitle">En god hjemmeside er mere end pænt design. Den skal overbevise besøgende om at vælge dig – og gøre det nemt at tage kontakt.</p>
                    <ul class="about-list" style="margin-top: 24px;">
                        <li><span class="check-icon">✓</span> Professionelt og moderne design</li>
                        <li><span class="check-icon">✓</span> Mobilvenlig og hurtig på alle enheder</li>
                        <li><span class="check-icon">✓</span> Bygget til at generere leads og henvendelser</li>
                        <li><span class="check-icon">✓</span> SEO-optimeret fra start</li>
                        <li><span class="check-icon">✓</span> Nem at opdatere og vedligeholde</li>
                    </ul>
                </div>
                <div class="subpage-stats">
                    <div class="result-card-light" style="text-align:center; padding: 40px 32px;">
                        <div class="metric-value" style="font-size:48px; margin-bottom:8px;">50+</div>
                        <div style="color:var(--gray-text); font-size:15px; margin-bottom:24px;">Hjemmesider bygget til håndværkere</div>
                        <div class="metric-value" style="font-size:48px; margin-bottom:8px;">2–3 uger</div>
                        <div style="color:var(--gray-text); font-size:15px;">Typisk leveringstid</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="subpage-cta">
        <h2>Klar til en ny hjemmeside?</h2>
        <p>Fortæl os om dit projekt og få et uforpligtende tilbud.</p>
        <a href="kontakt" class="btn-primary">Kom i gang</a>
    </div>
</div>

<SiteFooter />
