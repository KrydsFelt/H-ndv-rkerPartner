@page "/webudvikling"

<PageTitle>Webudvikling – HåndværkerPartner</PageTitle>

<NavBar />

<main class="web-page">
    <section class="web-hero">
        <div class="web-hero-copy">
            <h1>
                Hjemmesider der ser
                <span>ordentlige ud</span>
                og skaffer dig kunder.
            </h1>
            <p class="web-sub">
                Vi laver hjemmesider til håndværkere der ser ordentlige ud, loader hurtigt og gør det nemt for kunder at tage fat i dig.
            </p>
            <div class="web-hero-actions">
                <a href="kontakt" class="web-cta">Book uforpligtende samtale</a>
            </div>
        </div>
    </section>

    <section class="web-suite">
        <div class="web-suite-intro">
            <p class="web-section-eyebrow">Hjemmesider</p>
            <h2>En hjemmeside skal være mere end bare flot</h2>
            <p class="web-summary-title">Den skal gøre det nemt for kunder at forstå, hvad du laver, og tage fat i dig.</p>
            <p>
                Vi bygger hjemmesider til håndværkere, så de ser ordentlige ud, er nemme at bruge og hjælper dig med at få flere henvendelser. Det skal være enkelt, tydeligt og til at stole på.
            </p>
        </div>

        <div class="web-suite-grid">
            @foreach (var item in suiteItems)
            {
                <article class="web-suite-card">
                    <p class="web-suite-kicker">@item.Kicker</p>
                    <h3>@item.Title</h3>
                    <p>@item.Body</p>
                </article>
            }
        </div>
    </section>

    <section class="web-process-shell" @onmouseleave="ResetActiveStep">
        <div class="web-process-intro">
            <p class="web-section-eyebrow">Process</p>
            <h2>Fra første indtryk til færdig løsning</h2>
            <p>Vi bygger siden, så strategi, indhold og brugerflow hænger sammen fra starten, i stedet for at det først bliver rettet til bagefter.</p>
        </div>

        <div class="web-process">
            <div class="web-process-header">
                <p class="web-process-kicker">Fra første snak til færdig hjemmeside</p>
            </div>

            <div class="web-process-track">
                @foreach (var step in processSteps)
                {
                    var isActive = activeStep == step.Number;

                    <button type="button"
                            class="web-process-card @(isActive ? "is-active" : null)"
                            @onmouseover="@(() => SetActiveStep(step.Number))"
                            aria-expanded="@isActive">
                        <div class="web-process-top">
                            <span class="web-process-number">@step.Number</span>
                        </div>

                        <div class="web-process-head">
                            <h3>@step.Title</h3>
                            <p>@step.Subtitle</p>
                        </div>

                        <div class="web-process-body @(isActive ? "is-active" : null)">
                            <p>@step.Body</p>
                        </div>
                    </button>
                }
            </div>
        </div>
    </section>

    <section class="web-faq">
        <div class="web-faq-intro">
            <h2>Spørgsmål og svar</h2>
            <p>
                Her finder du svar på det vi oftest bliver spurgt om: hjemmesiden, hvordan vi arbejder, og hvad du kan forvente.
            </p>
        </div>

        <div class="web-faq-list">
            <details class="faq-item">
                <summary><span class="faq-title">Hvor lang tid tager det at bygge en hjemmeside?</span></summary>
                <p>De fleste projekter er live inden for 4-6 uger fra opstart, afhængigt af omfang og hvor hurtigt vi får indhold og feedback.</p>
            </details>
            <details class="faq-item">
                <summary><span class="faq-title">Hvad koster en hjemmeside hos jer?</span></summary>
                <p>Vi tilpasser løsningen til din virksomhed, så prisen afhænger af omfang. Du får altid et fast tilbud før vi starter — ingen overraskelser undervejs.</p>
            </details>
            <details class="faq-item">
                <summary><span class="faq-title">Skal jeg selv levere indhold og billeder?</span></summary>
                <p>Vi hjælper med struktur, tekst og billedretning. Du kender din forretning bedst, men vi sørger for at det bliver præsenteret skarpt.</p>
            </details>
            <details class="faq-item">
                <summary><span class="faq-title">Hvad sker der efter siden er live?</span></summary>
                <p>Vi kan stå for løbende drift, opdateringer og videreudvikling, så siden følger med din forretning over tid.</p>
            </details>
        </div>
    </section>

</main>

<ProductPageCta />
<SiteFooter />

@code {
    private string activeStep = "01";

    private readonly List<SuiteItem> suiteItems =
    [
        new("01", "Klar opbygning", "Vi bygger siden op, så kunder hurtigt kan se, hvem du er, hvad du laver, og hvordan de kontakter dig."),
        new("02", "Et ordentligt udtryk", "Designet skal få din virksomhed til at se troværdig og professionel ud, uden at det bliver smart for smarthedens skyld."),
        new("03", "God på mobil", "De fleste kigger fra telefonen. Derfor skal siden være nem at læse og bruge på både mobil, tablet og computer."),
        new("04", "Flere henvendelser", "Knapper, kontaktfelter og tekster bliver placeret, så det føles naturligt for kunden at tage næste skridt."),
        new("05", "Hurtig og nem", "Siden skal loade hurtigt og fungere uden bøvl, så kunden ikke falder fra undervejs."),
        new("06", "Kan justeres løbende", "Når siden er live, kan vi løbende rette tekst, billeder og indhold til, så den følger din forretning.")
    ];

    private readonly List<ProcessStep> processSteps =
    [
        new("01", "Vi starter med en snak", "Hvad du laver og hvilke kunder du vil have", "Vi finder ud af, hvilke opgaver du gerne vil have mere af, og hvad din hjemmeside skal hjælpe med i hverdagen."),
        new("02", "Vi lægger en plan", "Sider, indhold og det vigtigste budskab", "Vi planlægger siden, så kunder hurtigt kan se, hvad du laver, hvorfor de skal vælge dig, og hvordan de kontakter dig."),
        new("03", "Vi laver udtrykket", "Et ordentligt og troværdigt look", "Vi designer siden, så din virksomhed ser professionel ud og giver et godt førstehåndsindtryk."),
        new("04", "Vi bygger siden", "Den skal virke godt på både mobil og computer", "Vi bygger hjemmesiden, så den er hurtig, nem at bruge og fungerer ordentligt på alle skærme."),
        new("05", "Vi gør den klar", "Gennemgang, rettelser og publicering", "Inden siden går live, gennemgår vi den sammen og retter det sidste, så den står skarpt fra dag ét.")
    ];

    private void SetActiveStep(string number) => activeStep = number;
    private void ResetActiveStep() => activeStep = "01";

    private sealed record SuiteItem(string Kicker, string Title, string Body);
    private sealed record ProcessStep(string Number, string Title, string Subtitle, string Body);
}
