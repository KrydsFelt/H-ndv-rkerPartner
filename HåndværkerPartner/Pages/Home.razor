@page "/"
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>HåndværkerPartner – Din faglige samarbejdspartner</PageTitle>

<!-- NAVBAR -->
<nav class="@NavbarClass">
    <div class="nav-inner">
        <a href="#hero" class="nav-logo nav-logo-text" @onclick="NavHero" @onclick:preventDefault>
            <span class="nav-logo-line1">HÅNDVÆRKER</span><span class="nav-logo-line2">PARTNER</span>
        </a>
        <ul class="@NavLinksClass">
            <li><a href="#om-os" @onclick="NavOmOs" @onclick:preventDefault>Om HåndværkerPartner</a></li>
            <li><a href="meta">Meta Ads</a></li>
            <li><a href="google-ads">Google Ads</a></li>
            <li><a href="webudvikling">Hjemmesider</a></li>
            <li><a href="kontakt" class="nav-cta">Kontakt os</a></li>
        </ul>
        <button class="hamburger" @onclick="ToggleMenu" aria-label="Menu">
            <span></span><span></span><span></span>
        </button>
    </div>
</nav>

<!-- HERO -->
<section class="hero" id="hero">
    <video class="hero-video"
           src="herovideo/herovideo.mp4"
           autoplay
           muted
           loop
           playsinline
           preload="auto">
    </video>
    <div class="hero-overlay"></div>
    <div class="hero-inner">
        <div class="hero-content">
            <p class="hero-badge">Din faglige samarbejdspartner</p>
            <h2 class="hero-headline">
    <span>Flere leads, mere synlighed.</span>
    <span>Ingen binding</span>
</h2>
            <p class="hero-sub">Vi hjælper håndværksvirksomheder med flere kundehenvendelser gennem Meta Ads, Google Ads og moderne hjemmesider</p>
            <div class="hero-buttons">
                <button class="btn-primary" @onclick="HeroScrollKontakt">Bliv kontaktet</button>
            </div>
        </div>
        <div class="hero-arrow">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <polyline points="19 12 12 19 5 12"></polyline>
            </svg>
        </div>
    </div>
</section>

<!-- TRUST STRIP -->
<section class="trust-strip">
    <div class="trust-strip-inner">
        <div class="trust-item">
            <svg class="trust-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Ingen binding</span>
        </div>
        <div class="trust-item">
            <svg class="trust-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Gennemsigtig rapportering</span>
        </div>
        <div class="trust-item">
            <svg class="trust-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Specialister i håndværkere</span>
        </div>
        <div class="trust-item trust-item--stat">
            <span class="trust-stat-num">1.000+</span>
            <span>Leads genereret</span>
        </div>
        <div class="trust-item trust-item--stat">
            <span class="trust-stat-num">30+</span>
            <span>Virksomheder hjulpet</span>
        </div>
    </div>
</section>

<!-- SERVICES -->
<section class="section section--light" id="services">
    <div class="section-inner">
        <div class="services-header">
            <span class="section-tag">Vores ydelser</span>
            <h2 class="section-title">Boost din virksomhed med <span>de rigtige værktøjer</span></h2>
            <p class="section-subtitle">Tre dokumenterede marketingløsninger der tilsammen fylder din kalender, styrker din synlighed og skalerer din omsætning.</p>
        </div>

        <div class="services-grid-new" @onmouseleave="ResetActiveServicePanel">
            @foreach (var service in servicePanels)
            {
                var isActive = activeServicePanel == service.Key;

                <div class="service-card-new @(isActive ? "is-active" : null)"
                     @onmouseover="@(() => SetActiveServicePanel(service.Key))">
                    <div class="service-card-header">
                        <h3>@service.Title</h3>
                        @if (service.Key == "meta")
                        {
                            <img src="Pictures/meta-logo.png" alt="Meta" class="service-logo" />
                        }
                        else if (service.Key == "google")
                        {
                            <img src="Pictures/google-ads-logo.png" alt="Google Ads" class="service-logo" />
                        }
                        else
                        {
                            <svg class="service-logo" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M8 7l-5 5 5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M16 7l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M14 4l-4 16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        }
                    </div>
                    <p class="service-card-teaser">@service.Teaser</p>
                    <div class="service-card-case">
                        <span class="service-card-case-label">Resultat:</span>
                        <span>@service.Case</span>
                    </div>
                    @if (isActive)
                    {
                        <p class="service-card-desc">@service.Body</p>
                    }
                    <a href="@service.Href" class="service-card-hint">
                        <span>Læs mere</span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12"/>
                            <polyline points="12 5 19 12 12 19"/>
                        </svg>
                    </a>
                </div>
            }
        </div>

    </div>
</section>

<section class="testimonials-fullscreen" id="testimonials">
    <div class="tfs-inner">
        <h2 class="tfs-heading">Lyt ikke kun til os,<br><span>lyt til hvad vores kunder siger</span></h2>
        <div class="tfs-card">
            <div class="tfs-card-avatar">
                <img src="testimonials/emilsmultifix.jpg" alt="Emil fra Emils Multifix" />
            </div>
            <div class="tfs-quote">
                <span class="tfs-quote-mark" aria-hidden="true">&ldquo;</span>
                Fra nul kunder til fuld kalender på bare 2 måneder. Det her var afgørende for os.
            </div>
            <div class="tfs-author">
                <div class="tfs-author-info">
                    <div class="tfs-name">Emil</div>
                    <div class="tfs-role">Co-founder, Emils Multifix</div>
                </div>
            </div>
            <div class="tfs-stats">
                <div class="tfs-stat">
                    <div class="tfs-stat-value">17</div>
                    <div class="tfs-stat-label">Leads på 30 dage</div>
                </div>
                <div class="tfs-stat">
                    <div class="tfs-stat-value">33 kr</div>
                    <div class="tfs-stat-label">Pris pr. lead</div>
                </div>
                <div class="tfs-stat">
                    <div class="tfs-stat-value">4&times;</div>
                    <div class="tfs-stat-label">Flere henvendelser</div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section kpi-section" id="om-os">
    <div class="section-inner">
        <div class="kpi-layout">
            <div class="kpi-left">
                <span class="section-tag">Om HåndværkerPartner</span>
                <h2 class="section-title">Vi er <span>specialister</span> i håndværksbranchen</h2>
                <p class="section-subtitle">HåndværkerPartner er et bureau der udelukkende fokuserer på håndværks- og servicevirksomheder. Vi ved hvad der virker i din branche – fordi vi kun arbejder med den.</p>

                <ul class="about-list">
                    <li><span class="check-icon">✓</span> Specialist-bureau kun for håndværkere og servicevirksomheder</li>
                    <li><span class="check-icon">✓</span> Ingen binding – vi beholder dig fordi vi leverer resultater</li>
                    <li><span class="check-icon">✓</span> Gennemsigtig rapportering og direkte kommunikation</li>
                    <li><span class="check-icon">✓</span> Dokumenterede resultater med rigtige tal</li>
                    <li><span class="check-icon">✓</span> Personlig kontaktperson der kender din forretning</li>
                </ul>
            </div>

            <div class="kpi-right">
                <div class="kpi-grid-horizontal">
                    <div class="kpi-item">
                        <div class="kpi-value">+1.000</div>
                        <div class="kpi-label">LEADS GENERERET</div>
                    </div>
                    <div class="kpi-item">
                        <div class="kpi-value">+50</div>
                        <div class="kpi-label">AKTIVE KUNDER</div>
                    </div>
                    <div class="kpi-item">
                        <div class="kpi-value">33 kr.</div>
                        <div class="kpi-label">LAVESTE LEADPRIS</div>
                    </div>
                    <div class="kpi-item">
                        <div class="kpi-value">0 DAGES</div>
                        <div class="kpi-label">BINDING</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="kontakt">
    <ProductPageCta />
</section>

<!-- FOOTER -->
<footer class="footer">
    <div class="footer-inner">
        <div class="footer-logo-text">HÅNDVÆRKER<span>PARTNER</span></div>
        <p style="font-size:14px;">© 2024 HåndværkerPartner – Din faglige samarbejdspartner</p>
        <ul class="footer-links">
            <li><a href="#services" @onclick="NavServices" @onclick:preventDefault>Ydelser</a></li>
            <li><a href="#kontakt" @onclick="NavKontakt" @onclick:preventDefault>Kontakt</a></li>
        </ul>
    </div>
</footer>

<!-- SCROLL TOP -->
<button class="@ScrollTopClass" @onclick="ScrollToTop" title="Gå til toppen">↑</button>

@code {
    private bool scrolled = false;
    private bool menuOpen = false;
    private bool showScrollTop = false;
    private bool atBottom = false;
    private string activeServicePanel = "meta";

    private readonly List<ServicePanel> servicePanels =
    [
        new("meta", "Meta Ads", "Find dine kunder mens de scroller på Facebook & Instagram.", "23 leads genereret på 30 dage", "Kør målrettede Meta-kampagner der rammer præcis de kunder der har brug for en håndværker – og gør dem til kvalificerede leads. Vi håndterer opsætning, optimering og rapportering for maksimal ROI.", "meta"),
        new("google", "Google Ads", "Stå først når kunderne søger efter dit fag.", "Top 3 på Google på 14 dage", "Lad din virksomhed dukke op øverst, præcis når kunderne søger efter det du laver – og betal kun når de klikker. Vi optimerer dine Google Ads-kampagner for bedre synlighed og flere kvalificerede leads til lavere omkostninger.", "google-ads"),
        new("web", "WEB", "Hjemmesider bygget til at sælge – ikke bare se flotte ud.", "Konverteringer fordoblet efter relaunch", "Få en hurtig, professionel hjemmeside der faktisk konverterer besøgende til kunder – ingen tomme flotte designs. Vi bygger responsive websites der er optimeret for søgninger og designet til at generere flere opgaver.", "webudvikling")
    ];

    private string NavbarClass => scrolled ? "navbar scrolled" : "navbar";
    private string NavLinksClass => menuOpen ? "nav-links open" : "nav-links";
    private string ScrollTopClass => showScrollTop ? $"scroll-top{(atBottom ? " scroll-top--bottom" : "")}" : "scroll-top hidden";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var ref_ = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("initScrollHandler", ref_);
            await JS.InvokeVoidAsync("initCountUp");
            await ScrollToFragmentIfPresentAsync();
        }
    }

    [JSInvokable]
    public void OnScroll(double scrollY, double scrollHeight, double clientHeight)
    {
        scrolled = scrollY > 50;
        showScrollTop = scrollY > 400;
        atBottom = (scrollY + clientHeight) >= (scrollHeight - 100);
        StateHasChanged();
    }

    private void SetActiveServicePanel(string key) => activeServicePanel = key;
    private void ResetActiveServicePanel() => activeServicePanel = "meta";
    private void ToggleMenu() => menuOpen = !menuOpen;

    private async Task NavHero() { menuOpen = false; await ScrollTo("hero"); }
    private async Task NavServices() { menuOpen = false; await ScrollTo("services"); }
    private async Task NavOmOs() { menuOpen = false; await ScrollTo("om-os"); }
    private async Task NavKontakt() { menuOpen = false; await ScrollTo("kontakt"); }

    private async Task HeroScrollKontakt() => await ScrollTo("kontakt");
    private async Task ScrollToTop() => await ScrollTo("hero");

    private async Task ScrollTo(string id)
    {
        await JS.InvokeVoidAsync("scrollToSection", id);
    }

    private async Task ScrollToFragmentIfPresentAsync()
    {
        var fragment = new Uri(Nav.Uri).Fragment;
        if (string.IsNullOrWhiteSpace(fragment) || fragment.Length <= 1)
        {
            return;
        }

        await JS.InvokeVoidAsync("scrollToSection", fragment[1..]);
    }

    private sealed record ServicePanel(string Key, string Title, string Teaser, string Case, string Body, string Href);
}
