</section>

<!-- CONTACT -->
<section class="section contact" id="kontakt">
    <div class="section-inner">
        <div class="contact-inner">
            <div class="contact-text">
                <span class="section-tag">Kom i gang</span>
                <h2 class="section-title">Lad os snakke om din vækst</h2>
                <p class="section-subtitle">Book en gratis og uforpligtende samtale, og find ud af om vi er det rette match for din virksomhed.</p>

                <div class="contact-info">
                    <div class="contact-info-item">
                        <div class="contact-info-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.38 2 2 0 0 1 3.6 1.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.73a16 16 0 0 0 6.29 6.29l1.62-1.62a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                        </div>
                        <span>Ring til os – ingen binding, kun rådgivning</span>
                    </div>
                    <div class="contact-info-item">
                        <div class="contact-info-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                        </div>
                        <span>info@haandvaerkerpartner.dk</span>
                    </div>
                    <div class="contact-info-item">
                        <div class="contact-info-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        </div>
                        <span>Danmark – vi arbejder med kunder i hele landet</span>
                    </div>
                    <div class="contact-info-item">
                        <div class="contact-info-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        </div>
                        <span>Svar inden for 24 timer på hverdage</span>
                    </div>
                </div>
            </div>

            <div class="contact-form">
                <h3 style="font-size:22px; font-weight:800; margin-bottom:6px;">Gratis rådgivning</h3>
                <p style="font-size:14px; color:#666; margin-bottom:24px;">Udfyld formularen og vi kontakter dig hurtigst muligt.</p>

                @if (formSent)
                {
                    <div class="success-msg">
                        ✓ Tak! Vi kontakter dig inden for 24 timer.
                    </div>
                }
                else
                {
                    <div class="form-group">
                        <label class="form-label">Navn</label>
                        <input class="form-control" type="text" placeholder="Dit fulde navn" @bind="formName" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Telefon</label>
                        <input class="form-control" type="tel" placeholder="Dit telefonnummer" @bind="formPhone" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">E-mail</label>
                        <input class="form-control" type="email" placeholder="din@email.dk" @bind="formEmail" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Virksomhed</label>
                        <input class="form-control" type="text" placeholder="Hvad laver din virksomhed?" @bind="formCompany" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Besked (valgfrit)</label>
                        <textarea class="form-control" placeholder="Fortæl os lidt om din situation..." @bind="formMessage"></textarea>
                    </div>
                    <button class="form-submit" @onclick="SubmitForm">Send besked →</button>
                }
            </div>
        </div>
    </div>
</section>

<!-- FOOTER -->
<footer class="footer">
    <div class="footer-inner">
        <div class="footer-logo-text">Håndværker<span>Partner</span></div>
        <p style="font-size:14px;">© 2024 HåndværkerPartner – Din faglige samarbejdspartner</p>
        <ul class="footer-links">
            <li><a href="#services" @onclick="NavServices" @onclick:preventDefault>Ydelser</a></li>
            <li><a href="#kontakt" @onclick="NavKontakt" @onclick:preventDefault>Kontakt</a></li>
        </ul>
    </div>
</footer>

<!-- SCROLL TOP -->
<button class="@ScrollTopClass" @onclick="ScrollToTop" title="Gå til toppen">↑</button>

@code {
    private bool scrolled = false;
    private bool menuOpen = false;
    private bool showScrollTop = false;

    private bool formSent = false;
    private string formName = "";
    private string formPhone = "";
    private string formEmail = "";
    private string formCompany = "";
    private string formMessage = "";

    private string NavbarClass => scrolled ? "navbar scrolled" : "navbar";
    private string NavLinksClass => menuOpen ? "nav-links open" : "nav-links";
    private string ScrollTopClass => showScrollTop ? "scroll-top" : "scroll-top hidden";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initScrollHandler", DotNetObjectReference.Create(this));
        }
    }

    [JSInvokable]
    public void OnScroll(double scrollY)
    {
        scrolled = scrollY > 50;
        showScrollTop = scrollY > 400;
        StateHasChanged();
    }

    private void ToggleMenu() => menuOpen = !menuOpen;

    private async Task NavHero() { menuOpen = false; await ScrollTo("hero"); }
    private async Task NavServices() { menuOpen = false; await ScrollTo("services"); }
    private async Task NavResults() { menuOpen = false; await ScrollTo("results"); }
    private async Task NavOmOs() { menuOpen = false; await ScrollTo("om-os"); }
    private async Task NavTestimonials() { menuOpen = false; await ScrollTo("testimonials"); }
    private async Task NavKontakt() { menuOpen = false; await ScrollTo("kontakt"); }

    private async Task HeroScrollKontakt() => await ScrollTo("kontakt");
    private async Task HeroScrollServices() => await ScrollTo("services");
    private async Task ScrollToTop() => await ScrollTo("hero");

    private async Task ScrollTo(string id)
    {
        await JS.InvokeVoidAsync("scrollToSection", id);
    }

    private void SubmitForm()
    {
        if (!string.IsNullOrWhiteSpace(formName) && !string.IsNullOrWhiteSpace(formEmail))
        {
            formSent = true;
        }
    }
}
