@page "/"
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>HåndværkerPartner – Din faglige samarbejdspartner</PageTitle>

<!-- NAVBAR -->
<nav class="@NavbarClass">
    <div class="nav-inner">
        <a href="#hero" class="nav-logo nav-logo-text" @onclick="NavHero" @onclick:preventDefault>
            <span class="nav-logo-line1">HÅNDVÆRKER</span><span class="nav-logo-line2">PARTNER</span>
        </a>
        <ul class="@NavLinksClass">
            <li><a href="#om-os" @onclick="NavOmOs" @onclick:preventDefault>Om HåndværkerPartner</a></li>
            <li><a href="meta">Meta Ads</a></li>
            <li><a href="google-ads">Google Ads</a></li>
            <li><a href="webudvikling">WEB</a></li>
            <li><a href="kontakt" class="nav-cta">Kontakt os</a></li>
        </ul>
        <button class="hamburger" @onclick="ToggleMenu" aria-label="Menu">
            <span></span><span></span><span></span>
        </button>
    </div>
</nav>

<!-- HERO -->
<section class="hero" id="hero">
    <video class="hero-video"
           src="herovideo/herovideo.mp4"
           autoplay
           muted
           loop
           playsinline
           preload="auto">
    </video>
    <div class="hero-overlay"></div>
    <div class="hero-inner">
        <div class="hero-content">
            <p class="hero-badge">Din faglige samarbejdspartner</p>
            <h2>Vækst til håndværkere<br>der vil mere</h2>
            <p class="hero-sub">Vi hjælper håndværksvirksomheder med at skaffe flere kunder, styrke deres synlighed og skabe reel omsætningsvækst – gennem dokumenterede marketing- og leadstrategier.</p>
            <div class="hero-buttons">
                <button class="btn-primary" @onclick="HeroScrollKontakt">Bliv kontaktet</button>
            </div>
        </div>
        <div class="hero-arrow">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <polyline points="19 12 12 19 5 12"></polyline>
            </svg>
        </div>
    </div>
</section>

<!-- SERVICES -->
<section class="section section--light" id="services">
    <div class="section-inner">
        <div class="services-header">
            <span class="section-tag">Vores ydelser</span>
            <h2 class="section-title">Boost din virksomhed med <span>de rigtige værktøjer</span></h2>
            <p class="section-subtitle">Tre dokumenterede marketingløsninger der tilsammen fylder din kalender, styrker din synlighed og skalerer din omsætning.</p>
        </div>

        <div class="services-grid-new" @onmouseleave="ResetActiveServicePanel">
            @foreach (var service in servicePanels)
            {
                var isActive = activeServicePanel == service.Key;

                <div class="service-card-new @(isActive ? "is-active" : null)"
                     @onmouseover="@(() => SetActiveServicePanel(service.Key))">
                    <div class="service-card-header">
                        <h3>@service.Title</h3>
                        @if (service.Key == "meta")
                        {
                            <img src="Pictures/meta-logo.png" alt="Meta" class="service-logo" />
                        }
                        else if (service.Key == "google")
                        {
                            <img src="Pictures/google-ads-logo.png" alt="Google Ads" class="service-logo" />
                        }
                        else
                        {
                            <svg class="service-logo" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M8 7l-5 5 5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M16 7l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M14 4l-4 16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        }
                    </div>
                    <div class="service-card-body @(isActive ? "is-active" : null)">
                        <p>@service.Body</p>
                        <a href="@service.Href" class="service-link-more">Se mere <span>→</span></a>
                    </div>
                </div>
            }
        </div>

        <div class="services-accordion">
            <div class="acc-item @(openService == 0 ? "acc-open" : "")" @onclick="@(() => ToggleService(0))">
                <div class="acc-header">
                    <div class="acc-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg></div>
                    <span>Facebook &amp; Instagram Ads</span>
                    <div class="acc-chevron"></div>
                </div>
                <div class="acc-body">Målrettede annoncekampagner på Meta's platforme der genererer billige, kvalitetsleads til din håndværksvirksomhed.</div>
            </div>
            <div class="acc-item @(openService == 1 ? "acc-open" : "")" @onclick="@(() => ToggleService(1))">
                <div class="acc-header">
                    <div class="acc-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></div>
                    <span>Google Ads</span>
                    <div class="acc-chevron"></div>
                </div>
                <div class="acc-body">Vis dig øverst i Google-søgninger når kunderne aktivt søger efter netop de ydelser du tilbyder.</div>
            </div>
            <div class="acc-item @(openService == 2 ? "acc-open" : "")" @onclick="@(() => ToggleService(2))">
                <div class="acc-header">
                    <div class="acc-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg></div>
                    <span>SEO – Organisk synlighed</span>
                    <div class="acc-chevron"></div>
                </div>
                <div class="acc-body">Bliv fundet gratis på Google over tid med en stærk SEO-strategi der giver langsigtet og bæredygtig trafik.</div>
            </div>
            <div class="acc-item @(openService == 3 ? "acc-open" : "")" @onclick="@(() => ToggleService(3))">
                <div class="acc-header">
                    <div class="acc-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg></div>
                    <span>Hjemmeside</span>
                    <div class="acc-chevron"></div>
                </div>
                <div class="acc-body">Professionelle, hurtige og konverterende hjemmesider der overbeviser besøgende om at vælge dig.</div>
            </div>
            <div class="acc-item @(openService == 4 ? "acc-open" : "")" @onclick="@(() => ToggleService(4))">
                <div class="acc-header">
                    <div class="acc-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg></div>
                    <span>Leadgenerering</span>
                    <div class="acc-chevron"></div>
                </div>
                <div class="acc-body">Systematisk tilgang til at skaffe kvalificerede henvendelser – vi sætter systemer op der arbejder for dig døgnet rundt.</div>
            </div>
            <div class="acc-item @(openService == 5 ? "acc-open" : "")" @onclick="@(() => ToggleService(5))">
                <div class="acc-header">
                    <div class="acc-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg></div>
                    <span>Analyse &amp; Rapportering</span>
                    <div class="acc-chevron"></div>
                </div>
                <div class="acc-body">Gennemsigtig rapportering så du altid ved præcis hvad du får for dine marketingkroner – ingen skjulte tal.</div>
            </div>
        </div>
    </div>
</section>

<section class="testimonials-fullscreen" id="testimonials">
    <div class="tfs-inner">
        <h2 class="tfs-heading">Lyt ikke kun til os,<br><span>lyt til hvad vores kunder siger</span></h2>
        <div class="tfs-card">
            <div class="tfs-card-avatar">
                <img src="testimonials/emilsmultifix.jpg" alt="Emil fra Emils Multifix" />
            </div>
            <div class="tfs-quote">
                "Vi gik fra at have absolut nul kunder til at have en fuld kalender, hver eneste dag på kun 2 måneder. Det bedste af det hele er, at leadprisen er utrolig lav. Håndværkerpartner er squ den rigtige partner for os!"
            </div>
            <div class="tfs-author">
                <div class="tfs-author-info">
                    <div class="tfs-name">Emil</div>
                    <div class="tfs-role">Co-founder &amp; medarbejder af Emils Multifix</div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section kpi-section" id="om-os">
    <div class="section-inner">
        <div class="kpi-layout">
            <div class="kpi-left">
                <span class="section-tag">Om HåndværkerPartner</span>
                <h2 class="section-title">Vi er <span>specialister</span> i håndværksbranchen</h2>
                <p class="section-subtitle">HåndværkerPartner er et bureau der udelukkende fokuserer på håndværks- og servicevirksomheder. Vi ved hvad der virker i din branche – fordi vi kun arbejder med den.</p>

                <ul class="about-list">
                    <li><span class="check-icon">✓</span> Specialist-bureau kun for håndværkere og servicevirksomheder</li>
                    <li><span class="check-icon">✓</span> Ingen binding – vi beholder dig fordi vi leverer resultater</li>
                    <li><span class="check-icon">✓</span> Gennemsigtig rapportering og direkte kommunikation</li>
                    <li><span class="check-icon">✓</span> Dokumenterede resultater med rigtige tal</li>
                    <li><span class="check-icon">✓</span> Personlig kontaktperson der kender din forretning</li>
                </ul>
            </div>

            <div class="kpi-right">
                <div class="kpi-grid-horizontal">
                    <div class="kpi-item">
                        <div class="kpi-value">+1.000</div>
                        <div class="kpi-label">LEADS GENERERET</div>
                    </div>
                    <div class="kpi-item">
                        <div class="kpi-value">+50</div>
                        <div class="kpi-label">AKTIVE KUNDER</div>
                    </div>
                    <div class="kpi-item">
                        <div class="kpi-value">33 kr.</div>
                        <div class="kpi-label">LAVESTE LEADPRIS</div>
                    </div>
                    <div class="kpi-item">
                        <div class="kpi-value">0 DAGES</div>
                        <div class="kpi-label">BINDING</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="kontakt">
    <ProductPageCta />
</section>

<!-- FOOTER -->
<footer class="footer">
    <div class="footer-inner">
        <div class="footer-logo-text">HÅNDVÆRKER<span>PARTNER</span></div>
        <p style="font-size:14px;">© 2024 HåndværkerPartner – Din faglige samarbejdspartner</p>
        <ul class="footer-links">
            <li><a href="#services" @onclick="NavServices" @onclick:preventDefault>Ydelser</a></li>
            <li><a href="#kontakt" @onclick="NavKontakt" @onclick:preventDefault>Kontakt</a></li>
        </ul>
    </div>
</footer>

<!-- SCROLL TOP -->
<button class="@ScrollTopClass" @onclick="ScrollToTop" title="Gå til toppen">↑</button>

@code {
    private bool scrolled = false;
    private bool menuOpen = false;
    private bool showScrollTop = false;
    private bool atBottom = false;
    private int openService = -1;
    private string activeServicePanel = "meta";

    private readonly List<ServicePanel> servicePanels =
    [
        new("meta", "Meta Ads", "Kør målrettede Meta-kampagner der rammer præcis de kunder der har brug for en håndværker – og gør dem til billige, kvalificerede leads. Vi håndterer opsætning, optimering og rapportering for maksimal ROI.", "meta"),
        new("google", "Google Ads", "Lad din virksomhed dukke op øverst, præcis når kunderne søger efter det du laver – og betal kun når de klikker. Vi optimerer dine Google Ads-kampagner for bedre synlighed og flere kvalificerede leads til lavere omkostninger.", "google-ads"),
        new("web", "WEB", "Få en hurtig, professionel hjemmeside der faktisk konverterer besøgende til kunder – ingen tomme flotte designs. Vi bygger responsive websites der er optimeret for søgninger og designet til at generere flere orders.", "webudvikling")
    ];

    private string NavbarClass => scrolled ? "navbar scrolled" : "navbar";
    private string NavLinksClass => menuOpen ? "nav-links open" : "nav-links";
    private string ScrollTopClass => showScrollTop ? $"scroll-top{(atBottom ? " scroll-top--bottom" : "")}" : "scroll-top hidden";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var ref_ = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("initScrollHandler", ref_);
            await JS.InvokeVoidAsync("initCountUp");
            await ScrollToFragmentIfPresentAsync();
        }
    }

    [JSInvokable]
    public void OnScroll(double scrollY, double scrollHeight, double clientHeight)
    {
        scrolled = scrollY > 50;
        showScrollTop = scrollY > 400;
        atBottom = (scrollY + clientHeight) >= (scrollHeight - 100);
        StateHasChanged();
    }

    private void ToggleService(int i) => openService = openService == i ? -1 : i;
    private void SetActiveServicePanel(string key) => activeServicePanel = key;
    private void ResetActiveServicePanel() => activeServicePanel = "meta";
    private void ToggleMenu() => menuOpen = !menuOpen;

    private async Task NavHero() { menuOpen = false; await ScrollTo("hero"); }
    private async Task NavServices() { menuOpen = false; await ScrollTo("services"); }
    private async Task NavOmOs() { menuOpen = false; await ScrollTo("om-os"); }
    private async Task NavKontakt() { menuOpen = false; await ScrollTo("kontakt"); }

    private async Task HeroScrollKontakt() => await ScrollTo("kontakt");
    private async Task ScrollToTop() => await ScrollTo("hero");

    private async Task ScrollTo(string id)
    {
        await JS.InvokeVoidAsync("scrollToSection", id);
    }

    private async Task ScrollToFragmentIfPresentAsync()
    {
        var fragment = new Uri(Nav.Uri).Fragment;
        if (string.IsNullOrWhiteSpace(fragment) || fragment.Length <= 1)
        {
            return;
        }

        await JS.InvokeVoidAsync("scrollToSection", fragment[1..]);
    }

    private sealed record ServicePanel(string Key, string Title, string Body, string Href);
}
