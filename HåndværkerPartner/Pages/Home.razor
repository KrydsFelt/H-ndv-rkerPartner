@page "/"
@inject IJSRuntime JS

<PageTitle>HåndværkerPartner – Din faglige samarbejdspartner</PageTitle>

<!-- NAVBAR -->
<nav class="@NavbarClass">
    <div class="nav-inner">
        <a href="#hero" class="nav-logo nav-logo-text" @onclick="NavHero" @onclick:preventDefault>
            <span class="nav-logo-line1">HÅNDVÆRKER</span><span class="nav-logo-line2">PARTNER</span>
        </a>
        <ul class="@NavLinksClass">
            <li><a href="facebook-instagram">Facebook / Instagram Ads</a></li>
            <li><a href="google-ads">Google Ads</a></li>
            <li><a href="seo">SEO</a></li>
            <li><a href="webudvikling">Hjemmesider</a></li>
            <li><a href="cases">Cases</a></li>
            <li><a href="kontakt" class="nav-cta">Kontakt os</a></li>
        </ul>
        <button class="hamburger" @onclick="ToggleMenu" aria-label="Menu">
            <span></span><span></span><span></span>
        </button>
    </div>
</nav>

<!-- HERO -->
<section class="hero" id="hero">
    <div class="hero-overlay"></div>
    <div class="hero-inner">
        <p class="hero-badge">Din faglige samarbejdspartner</p>
        <h2>Vækst til håndværkere<br>der vil mere</h2>
        <p class="hero-sub">Vi hjælper håndværksvirksomheder med at skaffe flere kunder, styrke deres synlighed og skabe reel omsætningsvækst – gennem dokumenterede marketing- og leadstrategier.</p>
        <div class="hero-buttons">
            <button class="btn-primary" @onclick="HeroScrollKontakt">Bliv kontaktet</button>
        </div>
    </div>
</section>

<!-- CLIENTS MARQUEE -->
<div class="clients-strip">
    <div class="marquee-track">
        <div class="marquee-inner">
            <div class="client-logo">SKIMMELCONSULT</div>
            <div class="client-logo">FACADE RENOVERING DANMARK</div>
            <div class="client-logo">ISHØY &amp; PEDERSEN</div>
            <div class="client-logo">MPUDS.DK</div>
            <div class="client-logo">MB VINDUESPOLERING</div>
            <div class="client-logo">KASPER WEST</div>
            <div class="client-logo">CT ISOLERING</div>
            <div class="client-logo">NORD POLERING</div>
            <!-- duplicate for seamless loop -->
            <div class="client-logo">SKIMMELCONSULT</div>
            <div class="client-logo">FACADE RENOVERING DANMARK</div>
            <div class="client-logo">ISHØY &amp; PEDERSEN</div>
            <div class="client-logo">MPUDS.DK</div>
            <div class="client-logo">MB VINDUESPOLERING</div>
            <div class="client-logo">KASPER WEST</div>
            <div class="client-logo">CT ISOLERING</div>
            <div class="client-logo">NORD POLERING</div>
        </div>
    </div>
</div>

<!-- SERVICES -->
<section class="section section--light" id="services">
    <div class="section-inner">
        <div class="services-header">
            <span class="section-tag">Vores ydelser</span>
            <h2 class="section-title">Boost din virksomhed med <span>de rigtigeværktøjer</span></h2>
            <p class="section-subtitle">Seks dokumenterede marketingløsninger der tilsammen fylder din kalender, styrker din synlighed og skalerer din omsætning.</p>
        </div>

        <!-- Desktop: grid -->
        <div class="services-grid">
            <div class="service-card">
                <div class="service-card-illustration">
                    <div class="sci-icon-wrap sci-orange">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--orange)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                    </div>
                </div>
                <h3>Facebook &amp; Instagram Ads</h3>
                <p>Kør målrettede Meta-kampagner der rammer præcis de kunder der har brug for en håndværker – og gør dem til billige, kvalificerede leads.</p>
            </div>
            <div class="service-card">
                <div class="service-card-illustration">
                    <div class="sci-icon-wrap sci-orange">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--orange)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    </div>
                </div>
                <h3>Google Ads</h3>
                <p>Lad din virksomhed dukke op øverst, præcis når kunderne søger efter det du laver – og betal kun når de klikker.</p>
            </div>
            <div class="service-card">
                <div class="service-card-illustration">
                    <div class="sci-icon-wrap sci-orange">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--orange)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
                    </div>
                </div>
                <h3>SEO – Organisk synlighed</h3>
                <p>Byg en stærk tilstedeværelse på Google der giver dig gratis, vedvarende trafik – uden at betale per klik hver måned.</p>
            </div>
            <div class="service-card">
                <div class="service-card-illustration">
                    <div class="sci-icon-wrap sci-orange">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--orange)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                    </div>
                </div>
                <h3>Hjemmeside</h3>
                <p>Få en hurtig, professionel hjemmeside der faktisk konverterer besøgende til kunder – ingen tomme flotte designs.</p>
            </div>
            <div class="service-card">
                <div class="service-card-illustration">
                    <div class="sci-icon-wrap sci-orange">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--orange)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
                    </div>
                </div>
                <h3>Leadgenerering</h3>
                <p>Sæt systemer op der automatisk finder og kvalificerer nye kunder – så din pipeline aldrig står stille, selv når du sover.</p>
            </div>
            <div class="service-card">
                <div class="service-card-illustration">
                    <div class="sci-icon-wrap sci-orange">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--orange)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                    </div>
                </div>
                <h3>Analyse &amp; Rapportering</h3>
                <p>Se præcis hvad der virker med gennemsigtig rapportering på rigtige tal – ingen fine grafer der skjuler dårlige resultater.</p>
            </div>
        </div>

        <!-- Mobil: accordion -->
        <div class="services-accordion">
            <div class="acc-item @(openService == 0 ? "acc-open" : "")" @onclick="@(() => ToggleService(0))">
                <div class="acc-header">
                    <div class="acc-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg></div>
                    <span>Facebook &amp; Instagram Ads</span>
                    <div class="acc-chevron"></div>
                </div>
                <div class="acc-body">Målrettede annoncekampagner på Meta's platforme der genererer billige, kvalitetsleads til din håndværksvirksomhed.</div>
            </div>
            <div class="acc-item @(openService == 1 ? "acc-open" : "")" @onclick="@(() => ToggleService(1))">
                <div class="acc-header">
                    <div class="acc-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></div>
                    <span>Google Ads</span>
                    <div class="acc-chevron"></div>
                </div>
                <div class="acc-body">Vis dig øverst i Google-søgninger når kunderne aktivt søger efter netop de ydelser du tilbyder.</div>
            </div>
            <div class="acc-item @(openService == 2 ? "acc-open" : "")" @onclick="@(() => ToggleService(2))">
                <div class="acc-header">
                    <div class="acc-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg></div>
                    <span>SEO – Organisk synlighed</span>
                    <div class="acc-chevron"></div>
                </div>
                <div class="acc-body">Bliv fundet gratis på Google over tid med en stærk SEO-strategi der giver langsigtet og bæredygtig trafik.</div>
            </div>
            <div class="acc-item @(openService == 3 ? "acc-open" : "")" @onclick="@(() => ToggleService(3))">
                <div class="acc-header">
                    <div class="acc-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg></div>
                    <span>Hjemmeside</span>
                    <div class="acc-chevron"></div>
                </div>
                <div class="acc-body">Professionelle, hurtige og konverterende hjemmesider der overbeviser besøgende om at vælge dig.</div>
            </div>
            <div class="acc-item @(openService == 4 ? "acc-open" : "")" @onclick="@(() => ToggleService(4))">
                <div class="acc-header">
                    <div class="acc-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg></div>
                    <span>Leadgenerering</span>
                    <div class="acc-chevron"></div>
                </div>
                <div class="acc-body">Systematisk tilgang til at skaffe kvalificerede henvendelser – vi sætter systemer op der arbejder for dig døgnet rundt.</div>
            </div>
            <div class="acc-item @(openService == 5 ? "acc-open" : "")" @onclick="@(() => ToggleService(5))">
                <div class="acc-header">
                    <div class="acc-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg></div>
                    <span>Analyse &amp; Rapportering</span>
                    <div class="acc-chevron"></div>
                </div>
                <div class="acc-body">Gennemsigtig rapportering så du altid ved præcis hvad du får for dine marketingkroner – ingen skjulte tal.</div>
            </div>
        </div>
    </div>
</section>


<!-- MATCH -->
<section class="section match" id="match">
    <div class="section-inner">
        <span class="section-tag">Passer vi sammen?</span>
        <h2 class="section-title">Vi vælger vores kunder <span>med omhu</span></h2>
        <p class="section-subtitle">Vi siger nej til opgaver vi ikke kan skabe reel værdi på. Det betyder at dem vi siger ja til, altid får vores fulde fokus.</p>

        <div class="match-split">
            <div class="match-side match-side--no">
                <div class="match-side-label">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    Det passer ikke hvis
                </div>
                <ul class="match-list">
                    <li class="match-item">Du vil have ét quick-fix og er videre</li>
                    <li class="match-item">Du forventer resultater inden for den første uge</li>
                    <li class="match-item">Du ønsker ikke at samarbejde om indhold og retning</li>
                    <li class="match-item">Du er ikke klar til at håndtere flere henvendelser</li>
                    <li class="match-item">Din virksomhed er ikke sat op til vækst</li>
                </ul>
            </div>

            <div class="match-divider"></div>

            <div class="match-side match-side--yes">
                <div class="match-side-label">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    Det passer perfekt hvis
                </div>
                <ul class="match-list">
                    <li class="match-item">Du er klar til at investere i din vækst langsigtet</li>
                    <li class="match-item">Du leverer en ydelse du selv er stolt af</li>
                    <li class="match-item">Du vil gerne have en partner – ikke bare en leverandør</li>
                    <li class="match-item">Du er ambitiøs og klar til at skalere</li>
                    <li class="match-item">Du sætter pris på ærlighed og klare tal</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<!-- TESTIMONIALS -->
<section class="testimonials-fullscreen" id="testimonials">
    <button class="tfs-arrow tfs-arrow--prev" @onclick="PrevTestimonial">&#8249;</button>

    <div class="tfs-inner">
        <div class="tfs-quote">
            @testimonials[activeCard].Quote
        </div>
        <div class="tfs-author">
            <div class="tfs-avatar">@testimonials[activeCard].Initials</div>
            <div class="tfs-author-info">
                <div class="tfs-name">@testimonials[activeCard].Name</div>
                <div class="tfs-role">@testimonials[activeCard].Role.ToUpper()</div>
            </div>
        </div>
    </div>

    <button class="tfs-arrow tfs-arrow--next" @onclick="NextTestimonial">&#8250;</button>

    <div class="tfs-dots">
        @for (int i = 0; i < testimonials.Count; i++)
        {
            int idx = i;
            <span class="tfs-dot @(activeCard == idx ? "tfs-dot--active" : "")" @onclick="@(() => activeCard = idx)"></span>
        }
    </div>
</section>

<!-- ABOUT -->
<section class="section" id="om-os">
    <div class="section-inner">
        <div class="about-inner">
            <div>
                <span class="section-tag">Om HåndværkerPartner</span>
                <h2 class="section-title">Vi er <span>specialister</span> i håndværksbranchen</h2>
                <p class="section-subtitle">HåndværkerPartner er et bureau der udelukkende fokuserer på håndværks- og servicevirksomheder. Vi ved hvad der virker i din branche – fordi vi kun arbejder med den.</p>

                <ul class="about-list">
                    <li><span class="check-icon">✓</span> Specialist-bureau kun for håndværkere og servicevirksomheder</li>
                    <li><span class="check-icon">✓</span> Ingen binding – vi beholder dig fordi vi leverer resultater</li>
                    <li><span class="check-icon">✓</span> Gennemsigtig rapportering og direkte kommunikation</li>
                    <li><span class="check-icon">✓</span> Dokumenterede resultater med rigtige tal</li>
                    <li><span class="check-icon">✓</span> Personlig kontaktperson der kender din forretning</li>
                </ul>
            </div>

            <div class="about-visual">
                <div class="about-big-card">
                    <h3>HåndværkerPartner</h3>
                    <div class="tagline">Din faglige samarbejdspartner</div>
                    <p style="color:rgba(255,255,255,0.65); font-size:15px; line-height:1.7;">Vi besidder en indgående forståelse af de digitale kanaler, hvor dine kunder bruger deres tid, og vi udnytter avancerede planlægnings-, indkøbs- og analysemetoder til at inspirere potentielle kunder til handling.</p>
                    <div class="about-numbers">
                        <div class="about-num about-num-0">
                            <div class="n">50+</div>
                            <div class="l">Aktive kunder</div>
                        </div>
                        <div class="about-num about-num-1">
                            <div class="n">2 mio+</div>
                            <div class="l">Leads genereret</div>
                        </div>
                        <div class="about-num about-num-2">
                            <div class="n">33 kr</div>
                            <div class="l">Laveste leadpris</div>
                        </div>
                        <div class="about-num about-num-3">
                            <div class="n">0</div>
                            <div class="l">Binding</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CONTACT -->
<section class="section contact" id="kontakt">
    <div class="section-inner">
        <div class="contact-inner">
            <div class="contact-text">
                <span class="section-tag">Kom i gang</span>
                <h2 class="section-title">Lad os snakke om din vækst</h2>
                <p class="section-subtitle">Book en gratis og uforpligtende samtale, og find ud af om vi er det rette match for din virksomhed.</p>

                <div class="contact-info">
                    <div class="contact-info-item">
                        <div class="contact-info-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.38 2 2 0 0 1 3.6 1.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.73a16 16 0 0 0 6.29 6.29l1.62-1.62a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                        </div>
                        <span>Ring til os – ingen binding, kun rådgivning</span>
                    </div>
                    <div class="contact-info-item">
                        <div class="contact-info-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                        </div>
                        <span>info@haandvaerkerpartner.dk</span>
                    </div>
                    <div class="contact-info-item">
                        <div class="contact-info-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        </div>
                        <span>Danmark – vi arbejder med kunder i hele landet</span>
                    </div>
                    <div class="contact-info-item">
                        <div class="contact-info-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        </div>
                        <span>Svar inden for 24 timer på hverdage</span>
                    </div>
                </div>
            </div>

            <div class="contact-form">
                <h3 style="font-size:22px; font-weight:800; margin-bottom:6px;">Gratis rådgivning</h3>
                <p style="font-size:14px; color:#666; margin-bottom:24px;">Udfyld formularen og vi kontakter dig hurtigst muligt.</p>

                @if (formSent)
                {
                    <div class="success-msg">
                        ✓ Tak! Vi kontakter dig inden for 24 timer.
                    </div>
                }
                else
                {
                    <div class="form-group">
                        <label class="form-label">Navn</label>
                        <input class="form-control" type="text" placeholder="Dit fulde navn" @bind="formName" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Telefon</label>
                        <input class="form-control" type="tel" placeholder="Dit telefonnummer" @bind="formPhone" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">E-mail</label>
                        <input class="form-control" type="email" placeholder="din@email.dk" @bind="formEmail" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Virksomhed</label>
                        <input class="form-control" type="text" placeholder="Hvad laver din virksomhed?" @bind="formCompany" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Besked (valgfrit)</label>
                        <textarea class="form-control" placeholder="Fortæl os lidt om din situation..." @bind="formMessage"></textarea>
                    </div>
                    <button class="form-submit" @onclick="SubmitForm">Send besked →</button>
                }
            </div>
        </div>
    </div>
</section>

<!-- FOOTER -->
<footer class="footer">
    <div class="footer-inner">
        <div class="footer-logo-text">Håndværker<span>Partner</span></div>
        <p style="font-size:14px;">© 2024 HåndværkerPartner – Din faglige samarbejdspartner</p>
        <ul class="footer-links">
            <li><a href="#services" @onclick="NavServices" @onclick:preventDefault>Ydelser</a></li>
            <li><a href="#kontakt" @onclick="NavKontakt" @onclick:preventDefault>Kontakt</a></li>
        </ul>
    </div>
</footer>

<!-- SCROLL TOP -->
<button class="@ScrollTopClass" @onclick="ScrollToTop" title="Gå til toppen">↑</button>

@code {
    private bool scrolled = false;
    private bool menuOpen = false;
    private bool showScrollTop = false;

    private int activeCard = 0;
    private int openService = -1;
    private void ToggleService(int i) => openService = openService == i ? -1 : i;

    private class TestimonialItem
    {
        public string Quote { get; set; } = "";
        public string Name { get; set; } = "";
        public string Role { get; set; } = "";
        public string Initials { get; set; } = "";
    }

    private List<TestimonialItem> testimonials = new List<TestimonialItem>
    {
        new TestimonialItem { Quote = "\"Inden vi startede med HåndværkerPartner brugte vi tid og penge på annoncering der ikke gav noget. Efter tre måneder med dem fyldte vores kalender sig op af sig selv. Vi har ikke haft et stille kvartal siden.\"", Name = "Mikkel Andersen", Role = "Ejer af Andersen VVS", Initials = "MA" },
