@page "/"
@inject IJSRuntime JS

<PageTitle>HåndværkerPartner – Din faglige samarbejdspartner</PageTitle>

<!-- NAVBAR -->
<nav class="@NavbarClass">
    <div class="nav-inner">
        <a href="#hero" class="nav-logo" @onclick="NavHero" @onclick:preventDefault>
            <img src="logo.png" alt="HåndværkerPartner" />
        </a>
        <ul class="@NavLinksClass">
            <li><a href="facebook-instagram">Facebook / Instagram</a></li>
            <li><a href="google-ads">Google Ads</a></li>
            <li><a href="seo">SEO</a></li>
            <li><a href="webudvikling">Webudvikling</a></li>
            <li><a href="cases">Cases</a></li>
            <li><a href="kontakt" class="nav-cta">Kontakt os</a></li>
        </ul>
        <button class="hamburger" @onclick="ToggleMenu" aria-label="Menu">
            <span></span><span></span><span></span>
        </button>
    </div>
</nav>

<!-- HERO -->
<section class="hero" id="hero">
    <div class="hero-overlay"></div>
    <div class="hero-inner">
        <p class="hero-badge">Din faglige samarbejdspartner</p>
        <h1>Vækst til håndværkere<br>der vil mere</h1>
        <p class="hero-sub">Vi hjælper håndværksvirksomheder med at skaffe flere kunder, styrke deres synlighed og skabe reel omsætningsvækst – gennem dokumenterede marketing- og leadstrategier.</p>
        <div class="hero-buttons">
            <button class="btn-primary" @onclick="HeroScrollKontakt">Få gratis rådgivning</button>
        </div>
    </div>
</section>

<!-- CLIENTS MARQUEE -->
<div class="clients-strip">
    <div class="marquee-track">
        <div class="marquee-inner">
            <div class="client-logo">SKIMMELCONSULT</div>
            <div class="client-logo">FACADE RENOVERING DANMARK</div>
            <div class="client-logo">ISHØY &amp; PEDERSEN</div>
            <div class="client-logo">MPUDS.DK</div>
            <div class="client-logo">MB VINDUESPOLERING</div>
            <div class="client-logo">KASPER WEST</div>
            <div class="client-logo">CT ISOLERING</div>
            <div class="client-logo">NORD POLERING</div>
            <!-- duplicate for seamless loop -->
            <div class="client-logo">SKIMMELCONSULT</div>
            <div class="client-logo">FACADE RENOVERING DANMARK</div>
            <div class="client-logo">ISHØY &amp; PEDERSEN</div>
            <div class="client-logo">MPUDS.DK</div>
            <div class="client-logo">MB VINDUESPOLERING</div>
            <div class="client-logo">KASPER WEST</div>
            <div class="client-logo">CT ISOLERING</div>
            <div class="client-logo">NORD POLERING</div>
        </div>
    </div>
</div>

<!-- SERVICES -->
<section class="section" id="services">
    <div class="section-inner">
        <span class="section-tag">Vores ydelser</span>
        <h2 class="section-title">Alt hvad din virksomhed behøver for at <span>vækste</span></h2>
        <p class="section-subtitle">Vi tilbyder en komplet pakke af digitale marketing-løsninger skræddersyet til håndværksvirksomheder.</p>

        <div class="services-grid">
            <div class="service-card">
                <div class="service-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--orange)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                </div>
                <h3>Facebook &amp; Instagram Ads</h3>
                <p>Målrettede annoncekampagner på Meta's platforme der genererer billige, kvalitetsleads til din håndværksvirksomhed.</p>
            </div>
            <div class="service-card">
                <div class="service-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--orange)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                </div>
                <h3>Google Ads</h3>
                <p>Vis dig øverst i Google-søgninger når kunderne aktivt søger efter netop de ydelser du tilbyder.</p>
            </div>
            <div class="service-card">
                <div class="service-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--orange)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
                </div>
                <h3>SEO – Organisk synlighed</h3>
                <p>Bliv fundet gratis på Google over tid med en stærk SEO-strategi der giver langsigtet og bæredygtig trafik.</p>
            </div>
            <div class="service-card">
                <div class="service-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--orange)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                </div>
                <h3>Hjemmeside</h3>
                <p>Professionelle, hurtige og konverterende hjemmesider der overbeviser besøgende om at vælge dig.</p>
            </div>
            <div class="service-card">
                <div class="service-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--orange)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
                </div>
                <h3>Leadgenerering</h3>
                <p>Systematisk tilgang til at skaffe kvalificerede henvendelser – vi sætter systemer op der arbejder for dig døgnet rundt.</p>
            </div>
            <div class="service-card">
                <div class="service-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--orange)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                </div>
                <h3>Analyse &amp; Rapportering</h3>
                <p>Gennemsigtig rapportering så du altid ved præcis hvad du får for dine marketingkroner – ingen skjulte tal.</p>
            </div>
        </div>
    </div>
</section>


<!-- MATCH -->
<section class="section match" id="match">
    <div class="section-inner">
        <span class="section-tag">Passer vi sammen?</span>
        <h2 class="section-title">Vi vælger vores kunder <span>med omhu</span></h2>
        <p class="section-subtitle">Vi siger nej til opgaver vi ikke kan skabe reel værdi på. Det betyder at dem vi siger ja til, altid får vores fulde fokus.</p>

        <div class="match-split">
            <div class="match-side match-side--no">
                <div class="match-side-label">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    Det passer ikke
                </div>
                <ul class="match-list">
                    <li class="match-item">Du vil have ét quick-fix og er videre</li>
                    <li class="match-item">Du forventer resultater inden for den første uge</li>
                    <li class="match-item">Du ønsker ikke at samarbejde om indhold og retning</li>
                    <li class="match-item">Du er ikke klar til at håndtere flere henvendelser</li>
                    <li class="match-item">Din virksomhed er ikke sat op til vækst</li>
                </ul>
            </div>

            <div class="match-divider"></div>

            <div class="match-side match-side--yes">
                <div class="match-side-label">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    Det passer perfekt
                </div>
                <ul class="match-list">
                    <li class="match-item">Du er klar til at investere i din vækst langsigtet</li>
                    <li class="match-item">Du leverer en ydelse du selv er stolt af</li>
                    <li class="match-item">Du vil gerne have en partner – ikke bare en leverandør</li>
                    <li class="match-item">Du er ambitiøs og klar til at skalere</li>
                    <li class="match-item">Du sætter pris på ærlighed og klare tal</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<!-- TESTIMONIALS -->
<section class="section testimonials" id="testimonials">
    <div class="section-inner">
        <div class="testimonials-header">
            <span class="section-tag">Hvad siger vores kunder</span>
            <h2 class="section-title">Ord fra dem vi <span>arbejder for</span></h2>
        </div>

        <!-- Desktop: grid, Mobil: carousel -->
        <div class="testimonials-track">
            <div class="tcard">
                <div class="tcard-quote">"</div>
                <p class="tcard-text">Inden vi startede med HåndværkerPartner brugte vi tid og penge på annoncering der ikke gav noget. Efter tre måneder med dem fyldte vores kalender sig op af sig selv. Vi har ikke haft et stille kvartal siden.</p>
                <div class="tcard-bottom">
                    <div class="tcard-avatar">L</div>
                    <div><div class="tcard-name">Lars Mikkelsen</div><div class="tcard-role">Ejer af LM VVS &amp; Blikkenslager</div></div>
                    <div class="tcard-stars">★★★★★</div>
                </div>
            </div>
            <div class="tcard tcard--accent">
                <div class="tcard-quote">"</div>
                <p class="tcard-text">Vi gik fra næsten ingen online tilstedeværelse til at være den mest synlige maler i vores område på Google. HåndværkerPartner forstår håndværksbranchen på en måde som andre bureauer simpelthen ikke gør.</p>
                <div class="tcard-bottom">
                    <div class="tcard-avatar">S</div>
                    <div><div class="tcard-name">Søren Dalgaard</div><div class="tcard-role">Indehaver af Dalgaard Malerfirma</div></div>
                    <div class="tcard-stars">★★★★★</div>
                </div>
            </div>
            <div class="tcard">
                <div class="tcard-quote">"</div>
                <p class="tcard-text">Jeg var skeptisk i starten – jeg har prøvet to andre bureauer der lovede meget og leverede lidt. Her er det anderledes. De rapporterer på rigtige tal, svarer hurtigt og giver mig en følelse af at være prioriteret.</p>
                <div class="tcard-bottom">
                    <div class="tcard-avatar">A</div>
                    <div><div class="tcard-name">Anders Holm</div><div class="tcard-role">Ejer af Holm El-Service</div></div>
                    <div class="tcard-stars">★★★★★</div>
                </div>
            </div>
            <div class="tcard">
                <div class="tcard-quote">"</div>
                <p class="tcard-text">Vores nye hjemmeside er det bedste vi nogensinde har investeret i. Inden for den første uge efter lanceringen fik vi tre nye henvendelser via kontaktformularen. Siden er hurtig, ser professionel ud og konverterer.</p>
                <div class="tcard-bottom">
                    <div class="tcard-avatar">T</div>
                    <div><div class="tcard-name">Thomas Vestergaard</div><div class="tcard-role">Indehaver af Vestergaard Tømrer</div></div>
                    <div class="tcard-stars">★★★★★</div>
                </div>
            </div>
        </div>

        <div class="carousel-dots">
            <span class="dot @(activeCard == 0 ? "dot--active" : "")" @onclick="@(() => GoToCard(0))"></span>
            <span class="dot @(activeCard == 1 ? "dot--active" : "")" @onclick="@(() => GoToCard(1))"></span>
            <span class="dot @(activeCard == 2 ? "dot--active" : "")" @onclick="@(() => GoToCard(2))"></span>
            <span class="dot @(activeCard == 3 ? "dot--active" : "")" @onclick="@(() => GoToCard(3))"></span>
        </div>
    </div>
</section>

<!-- ABOUT -->
