@page "/"
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>HåndværkerPartner – Din faglige samarbejdspartner</PageTitle>

<!-- NAVBAR -->
<nav class="@NavbarClass">
    <div class="nav-inner">
        <a href="#hero" class="nav-logo nav-logo-text" @onclick="NavHero" @onclick:preventDefault>
            <span class="nav-logo-line1">HÅNDVÆRKER</span><span class="nav-logo-line2">PARTNER</span>
        </a>
        <ul class="@NavLinksClass">
            <li><a href="#om-os" @onclick="NavOmOs" @onclick:preventDefault>Om HåndværkerPartner</a></li>
            <li><a href="meta">Meta Ads</a></li>
            <li><a href="google-ads">Google Ads</a></li>
            <li><a href="webudvikling">Hjemmesider</a></li>
            <li><a href="kontakt" class="nav-cta">Kontakt os</a></li>
        </ul>
        <button class="hamburger" @onclick="ToggleMenu" aria-label="Menu">
            <span></span><span></span><span></span>
        </button>
    </div>
</nav>

<!-- HERO -->
<section class="hero" id="hero">
    <video class="hero-video"
           src="herovideo/herovideo.mp4"
           autoplay
           muted
           loop
           playsinline
           preload="auto">
    </video>
    <div class="hero-overlay"></div>
    <div class="hero-inner">
        <div class="hero-content">
            <p class="hero-badge">Din faglige samarbejdspartner</p>
            <h2 class="hero-headline">
    <span>Flere leads, mere synlighed.</span>
    <span>Ingen binding</span>
</h2>
            <p class="hero-sub">Vi hjælper håndværkere med at få flere kunder ind gennem annoncer på Facebook, Google og en god hjemmeside</p>
            <div class="hero-buttons">
                <a href="kontakt" class="btn-primary">Bliv kontaktet</a>
            </div>
        </div>
        <div class="hero-arrow">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <polyline points="19 12 12 19 5 12"></polyline>
            </svg>
        </div>
    </div>
</section>

<!-- TRUST STRIP -->
<section class="trust-strip">
    <div class="trust-strip-inner">
        <div class="trust-item">
            <svg class="trust-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Ingen binding</span>
        </div>
        <div class="trust-item">
            <svg class="trust-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Klare tal hver måned</span>
        </div>
        <div class="trust-item">
            <svg class="trust-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Vi arbejder kun med håndværkere</span>
        </div>
        <div class="trust-item trust-item--stat">
            <span class="trust-stat-num">1.000+</span>
            <span>Henvendelser skaffet</span>
        </div>
        <div class="trust-item trust-item--stat">
            <span class="trust-stat-num">30+</span>
            <span>Virksomheder hjulpet</span>
        </div>
    </div>
</section>

<!-- SERVICES -->
<section class="section section--light" id="services">
    <div class="section-inner">
        <div class="services-header">
            <span class="section-tag">Vores ydelser</span>
            <h2 class="section-title">Få flere kunder med <span>de rigtige værktøjer</span></h2>
            <p class="section-subtitle">Tre ting der virker, og som tilsammen giver dig flere kunder, mere synlighed og en fuld kalender.</p>
        </div>

        <div class="services-grid-new" @onmouseleave="ResetActiveServicePanel">
            @foreach (var service in servicePanels)
            {
                var isActive = activeServicePanel == service.Key;

                <div class="service-card-new @(isActive ? "is-active" : null)"
                     @onmouseover="@(() => SetActiveServicePanel(service.Key))">
                    <div class="service-card-header">
                        <h3>@service.Title</h3>
                        @if (service.Key == "meta")
                        {
                            <img src="Pictures/meta-logo.png" alt="Meta" class="service-logo service-logo--meta" />
                        }
                        else if (service.Key == "google")
                        {
                            <img src="Pictures/google-ads-logo.png" alt="Google Ads" class="service-logo" />
                        }
                        else
                        {
                            <svg class="service-logo" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <rect x="3.5" y="5" width="17" height="12" rx="2.5" stroke="currentColor" stroke-width="1.8"/>
                                <path d="M8 19h8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                                <path d="M12 17v2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                                <path d="M7.5 9.5h9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                                <path d="M7.5 12.5h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                            </svg>
                        }
                    </div>
                    <p class="service-card-teaser">@service.Teaser</p>
                    <div class="service-card-case">
                        <span class="service-card-case-label">Resultat:</span>
                        <span>@service.Case</span>
                    </div>
                    @if (isActive)
                    {
                        <p class="service-card-desc">@service.Body</p>
                    }
                    <a href="@service.Href" class="service-card-hint">
                        <span>Læs mere</span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12"/>
                            <polyline points="12 5 19 12 12 19"/>
                        </svg>
                    </a>
                </div>
            }
        </div>

    </div>
</section>

<section class="testimonials-fullscreen" id="testimonials">
    <div class="tfs-inner">
        <h2 class="tfs-heading">Lyt ikke kun til os,<br><span>lyt til hvad vores kunder siger</span></h2>
        <div class="tfs-card">
            <div class="tfs-card-avatar">
                <img src="testimonials/emilsmultifix.jpg" alt="Emil fra Emils Multifix" />
            </div>
            <div class="tfs-quote">
                <span class="tfs-quote-mark" aria-hidden="true">&ldquo;</span>
                Fra nul kunder til fuld kalender på bare 2 måneder. Det her var afgørende for os.
            </div>
            <div class="tfs-author">
                <div class="tfs-author-info">
                    <div class="tfs-name">Emil</div>
                    <div class="tfs-role">Co-founder, Emils Multifix</div>
                </div>
            </div>
            <div class="tfs-stats">
                <div class="tfs-stat">
                    <div class="tfs-stat-value">17</div>
                    <div class="tfs-stat-label">Leads på 30 dage</div>
                </div>
                <div class="tfs-stat">
                    <div class="tfs-stat-value">33 kr</div>
                    <div class="tfs-stat-label">Pris pr. lead</div>
                </div>
                <div class="tfs-stat">
                    <div class="tfs-stat-value">4&times;</div>
                    <div class="tfs-stat-label">Flere henvendelser</div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section kpi-section" id="om-os">
    <div class="section-inner">
        <div class="kpi-layout">
            <div class="kpi-left">
                <span class="section-tag">Om HåndværkerPartner</span>
                <h2 class="section-title">Vi kender <span>din branche</span></h2>
                <p class="section-subtitle">HåndværkerPartner arbejder kun med håndværkere og servicevirksomheder. Vi ved hvad der virker hos jer – fordi det er alt vi laver.</p>

                <ul class="about-list">
                    <li><span class="check-icon">✓</span> Vi arbejder kun med håndværkere og servicevirksomheder</li>
                    <li><span class="check-icon">✓</span> Ingen binding – vi beholder dig fordi det virker</li>
                    <li><span class="check-icon">✓</span> Klare tal og direkte snak</li>
                    <li><span class="check-icon">✓</span> Rigtige resultater med rigtige tal</li>
                    <li><span class="check-icon">✓</span> Du har én fast person at snakke med</li>
                </ul>
            </div>

            <aside class="kpi-right" data-count-up-section>
                <div class="kpi-grid-horizontal">
                    @foreach (var kpi in aboutKpis)
                    {
                        <article class="kpi-item" data-kpi-reveal>
                            <div class="kpi-icon" aria-hidden="true">
                                @switch (kpi.Icon)
                                {
                                    case "spark":
                                        <svg viewBox="0 0 24 24" fill="none">
                                            <path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3Z" />
                                        </svg>
                                        break;
                                    case "users":
                                        <svg viewBox="0 0 24 24" fill="none">
                                            <path d="M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" />
                                            <path d="M17 12a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z" />
                                            <path d="M4.5 18a4.5 4.5 0 0 1 9 0" />
                                            <path d="M14 18a3.5 3.5 0 0 1 6 0" />
                                        </svg>
                                        break;
                                    case "coin":
                                        <svg viewBox="0 0 24 24" fill="none">
                                            <circle cx="12" cy="12" r="7" />
                                            <path d="M9.5 10.5c.3-1 1.2-1.5 2.5-1.5 1.5 0 2.5.8 2.5 2 0 2.7-4.5 1.4-4.5 4 0 1.2 1 2 2.5 2 1.3 0 2.2-.5 2.5-1.5" />
                                            <path d="M12 7.5v9" />
                                        </svg>
                                        break;
                                    default:
                                        <svg viewBox="0 0 24 24" fill="none">
                                            <path d="M7 12.5 10.2 16 17 8.5" />
                                            <path d="M12 3c4.97 0 9 4.03 9 9s-4.03 9-9 9-9-4.03-9-9 4.03-9 9-9Z" />
                                        </svg>
                                        break;
                                }
                            </div>
                            <div class="kpi-value"
                                 data-count-up
                                 data-count-end="@kpi.CountEnd"
                                 data-count-prefix="@kpi.Prefix"
                                 data-count-suffix="@kpi.Suffix"
                                 data-count-duration="@kpi.Duration"
                                 data-count-format="@kpi.Format">
                                @kpi.InitialValue
                            </div>
                            <div class="kpi-label">@kpi.Label</div>
                            <p class="kpi-note">@kpi.Note</p>
                        </article>
                    }
                </div>
            </aside>
        </div>
    </div>
</section>

<section id="kontakt">
    <ProductPageCta />
</section>

<SiteFooter />

<!-- SCROLL TOP -->
<button class="@ScrollTopClass" @onclick="ScrollToTop" title="Gå til toppen">↑</button>

@code {
    private bool scrolled = false;
    private bool menuOpen = false;
    private bool showScrollTop = false;
    private bool atBottom = false;
    private string activeServicePanel = "meta";

    private readonly List<ServicePanel> servicePanels =
    [
        new("meta", "Meta Ads", "Find dine kunder mens de scroller på Facebook og Instagram.", "23 henvendelser på 30 dage", "Vi laver annoncer på Facebook og Instagram der rammer de kunder der lige nu mangler en håndværker. Vi sætter det op, holder øje med det og melder tilbage hvad der virker.", "meta"),
        new("google", "Google Ads", "Stå først når kunderne søger efter dit fag.", "Top 3 på Google på 14 dage", "Vi sørger for at din virksomhed dukker op øverst når kunderne søger efter det du laver – og du betaler kun når nogen klikker. Vi sørger for at få mest muligt ud af pengene.", "google-ads"),
        new("web", "Hjemmeside", "Hjemmesider der ser ordentlige ud og giver dig flere kunder.", "Dobbelt så mange henvendelser efter ny side", "Vi bygger en hurtig og ordentlig hjemmeside der faktisk får folk til at tage fat i dig. Den ser godt ud, virker på mobilen og er nem at finde på Google.", "webudvikling")
    ];

    private readonly List<AboutKpi> aboutKpis =
    [
        new("spark", "+1.000", 1000, "+", "", 1800, "da-DK", "Henvendelser skaffet", "Fra kampagner for håndværkere og servicevirksomheder."),
        new("users", "+50", 50, "+", "", 1400, "plain", "Aktive kunder", "Virksomheder vi hjælper med flere henvendelser hver måned."),
        new("coin", "33 kr.", 33, "", " kr.", 1500, "plain", "Laveste pris pr. henvendelse", "Et eksempel fra en kampagne der ramte rigtigt lokalt."),
        new("shield", "0 dage", 0, "", " dage", 900, "plain", "Binding", "Vi vil hellere vælges på resultater end på lange aftaler.")
    ];

    private string NavbarClass => scrolled ? "navbar scrolled" : "navbar";
    private string NavLinksClass => menuOpen ? "nav-links open" : "nav-links";
    private string ScrollTopClass => showScrollTop ? $"scroll-top{(atBottom ? " scroll-top--bottom" : "")}" : "scroll-top hidden";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var ref_ = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("initScrollHandler", ref_);
            await JS.InvokeVoidAsync("initCountUp");
            await ScrollToFragmentIfPresentAsync();
        }
    }

    [JSInvokable]
    public void OnScroll(double scrollY, double scrollHeight, double clientHeight)
    {
        scrolled = scrollY > 50;
        showScrollTop = scrollY > 400;
        atBottom = (scrollY + clientHeight) >= (scrollHeight - 100);
        StateHasChanged();
    }

    private void SetActiveServicePanel(string key) => activeServicePanel = key;
    private void ResetActiveServicePanel() => activeServicePanel = "meta";
    private void ToggleMenu() => menuOpen = !menuOpen;

    private async Task NavHero() { menuOpen = false; await ScrollTo("hero"); }
    private async Task NavServices() { menuOpen = false; await ScrollTo("services"); }
    private async Task NavOmOs() { menuOpen = false; await ScrollTo("om-os"); }
    private async Task ScrollToTop() => await ScrollTo("hero");

    private async Task ScrollTo(string id)
    {
        await JS.InvokeVoidAsync("scrollToSection", id);
    }

    private async Task ScrollToFragmentIfPresentAsync()
    {
        var fragment = new Uri(Nav.Uri).Fragment;
        if (string.IsNullOrWhiteSpace(fragment) || fragment.Length <= 1)
        {
            return;
        }

        await JS.InvokeVoidAsync("scrollToSection", fragment[1..]);
    }

    private sealed record ServicePanel(string Key, string Title, string Teaser, string Case, string Body, string Href);
    private sealed record AboutKpi(string Icon, string InitialValue, int CountEnd, string Prefix, string Suffix, int Duration, string Format, string Label, string Note);
}
