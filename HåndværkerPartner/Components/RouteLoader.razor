<div class="route-loader @(isComplete ? "route-loader--complete" : "")">
    <div class="rl-shell">
        <span @ref="textRef" class="rl-text"></span>
        <span class="rl-cursor"></span>
    </div>
</div>

@inject IJSRuntime JS

@code {
    private ElementReference textRef;
    private bool isComplete = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("runRouteLoaderAnimation", textRef, DotNetObjectReference.Create(this));
        }
    }

    [JSInvokable]
    public async Task OnTypingComplete()
    {
        await Task.Delay(1400);
        isComplete = true;
        StateHasChanged();
        await Task.Delay(1100);
        await JS.InvokeVoidAsync("eval", "document.body.classList.add('route-complete')");
    }
}
