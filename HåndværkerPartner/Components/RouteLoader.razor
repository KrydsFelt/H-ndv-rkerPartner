<div class="route-loader @(IsVisible ? "is-visible" : "is-hidden")" aria-hidden="@(!IsVisible)">
    <div class="route-loader__shell">
        <div class="route-loader__logo">
            <span>@TypedText</span>
            @if (ShowTitleCursor)
            {
                <span class="route-loader__cursor"></span>
            }
        </div>
        <div class="route-loader__subtitle">
            <span>@TypedSubtitle</span>
            @if (ShowSubtitleCursor)
            {
                <span class="route-loader__cursor route-loader__cursor--subtitle"></span>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public string TypedText { get; set; } = string.Empty;
    [Parameter] public string TypedSubtitle { get; set; } = string.Empty;
    [Parameter] public bool ShowTitleCursor { get; set; }
    [Parameter] public bool ShowSubtitleCursor { get; set; }
}
