@inject NavigationManager Nav
@inject IJSRuntime JS

<nav class="navbar">
    <div class="nav-inner">
        <a href="" class="nav-logo">
            <img src="logo.png" alt="HåndværkerPartner" />
        </a>
        <ul class="nav-links">
            <li><a href="facebook-instagram" class="@Active("facebook-instagram")">Facebook / Instagram</a></li>
            <li><a href="google-ads" class="@Active("google-ads")">Google Ads</a></li>
            <li><a href="seo" class="@Active("seo")">SEO</a></li>
            <li><a href="webudvikling" class="@Active("webudvikling")">Webudvikling</a></li>
            <li><a href="cases" class="@Active("cases")">Cases</a></li>
            <li><a href="kontakt" class="@("nav-cta " + Active("kontakt"))">Kontakt os</a></li>
        </ul>
        <button class="hamburger @(menuOpen ? "open" : "")" @onclick="ToggleMenu" aria-label="Menu">
            <span></span><span></span><span></span>
        </button>
    </div>
</nav>

@if (menuOpen)
{
    <div class="mobile-menu">
        <div class="mobile-menu-inner">
            <a href="" class="mobile-menu-logo" @onclick="CloseMenu">
                <img src="logo.png" alt="HåndværkerPartner" />
            </a>
            <nav class="mobile-nav">
                <a href="facebook-instagram" @onclick="CloseMenu">Facebook / Instagram</a>
                <a href="google-ads" @onclick="CloseMenu">Google Ads</a>
                <a href="seo" @onclick="CloseMenu">SEO</a>
                <a href="webudvikling" @onclick="CloseMenu">Webudvikling</a>
                <a href="cases" @onclick="CloseMenu">Cases</a>
            </nav>
            <a href="kontakt" class="mobile-menu-cta" @onclick="CloseMenu">Kontakt os</a>
        </div>
    </div>
}

@code {
    private bool menuOpen = false;

    private async Task ToggleMenu()
    {
        menuOpen = !menuOpen;
        if (menuOpen) await JS.InvokeVoidAsync("lockScroll");
        else await JS.InvokeVoidAsync("unlockScroll");
    }

    private async Task CloseMenu()
    {
        menuOpen = false;
        await JS.InvokeVoidAsync("unlockScroll");
    }

    private string Active(string segment)
    {
        return Nav.Uri.Contains("/" + segment, StringComparison.OrdinalIgnoreCase) ? "nav-active" : "";
    }
}
