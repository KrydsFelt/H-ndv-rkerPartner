@inject NavigationManager Nav
@inject IJSRuntime JS

<nav class="navbar">
    <div class="nav-inner">
        <a href="" class="nav-logo nav-logo-text">
            <span class="nav-logo-line1">HÅNDVÆRKER</span><span class="nav-logo-line2">PARTNER</span>
        </a>
        <ul class="nav-links">
            <li><a href="/#om-os">Om HåndværkerPartner</a></li>
            <li class="nav-ydelser-item">
                <button type="button" class="nav-ydelser-trigger @(AnyServiceActive() ? "nav-active" : "")">Services</button>
                <div class="nav-ydelser-dropdown">
                    <div class="nav-ydelser-dropdown-inner">
                        <a href="facebook-instagram" class="@Active("facebook-instagram")">
                            <span class="nav-service-title">Meta Ads</span>
                            <span class="nav-service-note">Betalt synlighed på Meta</span>
                        </a>
                        <a href="google-ads" class="@Active("google-ads")">
                            <span class="nav-service-title">Google Ads</span>
                            <span class="nav-service-note">Fang kunder med købssignal</span>
                        </a>
                        <a href="webudvikling" class="@Active("webudvikling")">
                            <span class="nav-service-title">Hjemmesider</span>
                            <span class="nav-service-note">Designet til at konvertere</span>
                        </a>
                    </div>
                </div>
            </li>
            <li><a href="kontakt" class="@("nav-cta " + Active("kontakt"))">Kontakt os</a></li>
        </ul>
        <button class="hamburger @(menuOpen ? "open" : "")" @onclick="ToggleMenu" aria-label="Menu">
            <span></span><span></span><span></span>
        </button>
    </div>
</nav>

@if (menuOpen)
{
    <div class="mobile-menu">
        <div class="mobile-menu-inner">
            <a href="" class="mobile-menu-logo nav-logo-text" @onclick="CloseMenu">
                <span class="nav-logo-line1">HÅNDVÆRKER</span><span class="nav-logo-line2">PARTNER</span>
            </a>
            <nav class="mobile-nav">
                <a href="/#om-os" @onclick="CloseMenu">Om HåndværkerPartner</a>
                <div class="mobile-nav-group-label">Services</div>
                <a href="facebook-instagram" class="mobile-nav-sub" @onclick="CloseMenu">Meta Ads</a>
                <a href="google-ads" class="mobile-nav-sub" @onclick="CloseMenu">Google Ads</a>
                <a href="webudvikling" class="mobile-nav-sub" @onclick="CloseMenu">Hjemmesider</a>
            </nav>
            <a href="kontakt" class="mobile-menu-cta" @onclick="CloseMenu">Kontakt os</a>
        </div>
    </div>
}

@code {
    private bool menuOpen = false;

    private async Task ToggleMenu()
    {
        menuOpen = !menuOpen;
        if (menuOpen) await JS.InvokeVoidAsync("lockScroll");
        else await JS.InvokeVoidAsync("unlockScroll");
    }

    private async Task CloseMenu()
    {
        menuOpen = false;
        await JS.InvokeVoidAsync("unlockScroll");
    }

    private string Active(string segment)
    {
        return Nav.Uri.Contains("/" + segment, StringComparison.OrdinalIgnoreCase) ? "nav-active" : "";
    }

    private bool AnyServiceActive()
    {
        return Active("facebook-instagram").Length > 0
            || Active("google-ads").Length > 0
            || Active("webudvikling").Length > 0;
    }
}
