<RouteLoader IsVisible="@_loaderVisible"
             TypedText="@_typedText"
             TypedSubtitle="@_typedSubtitle"
             ShowTitleCursor="@_showTitleCursor"
             ShowSubtitleCursor="@_showSubtitleCursor" />

<Router AppAssembly="@typeof(App).Assembly" OnNavigateAsync="HandleNavigationAsync">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <p role="alert">Sorry, there's nothing at this address.</p>
        </LayoutView>
    </NotFound>
</Router>

@code {
    private const string LoaderTitle = "Håndværkerpartner";
    private const string LoaderSubtitle = "Når det skal gøres ordenligt";

    private bool _hasHandledInitialNavigation;
    private bool _loaderVisible;
    private string _typedText = string.Empty;
    private string _typedSubtitle = string.Empty;
    private bool _showTitleCursor;
    private bool _showSubtitleCursor;
    private int _navigationSequence;

    private async Task HandleNavigationAsync(NavigationContext context)
    {
        var sequence = Interlocked.Increment(ref _navigationSequence);

        if (!_hasHandledInitialNavigation)
        {
            _hasHandledInitialNavigation = true;
            return;
        }

        if (!IsHomePath(context.Path))
        {
            _loaderVisible = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        _loaderVisible = true;
        _typedText = string.Empty;
        _typedSubtitle = string.Empty;
        _showTitleCursor = true;
        _showSubtitleCursor = false;
        await InvokeAsync(StateHasChanged);

        try
        {
            await RunLoaderAnimationAsync(sequence, context.CancellationToken);
        }
        catch (OperationCanceledException)
        {
            if (sequence == _navigationSequence)
            {
                _loaderVisible = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task RunLoaderAnimationAsync(int sequence, CancellationToken cancellationToken)
    {
        var totalTitleChars = LoaderTitle.Length;

        for (var index = 1; index <= totalTitleChars; index++)
        {
            cancellationToken.ThrowIfCancellationRequested();

            if (sequence != _navigationSequence)
            {
                return;
            }

            _typedText = LoaderTitle[..index];
            await InvokeAsync(StateHasChanged);
            await Task.Delay(90, cancellationToken);
        }

        await Task.Delay(450, cancellationToken);

        _showTitleCursor = false;
        _showSubtitleCursor = true;
        await InvokeAsync(StateHasChanged);

        var totalSubtitleChars = LoaderSubtitle.Length;

        for (var index = 1; index <= totalSubtitleChars; index++)
        {
            cancellationToken.ThrowIfCancellationRequested();

            if (sequence != _navigationSequence)
            {
                return;
            }

            _typedSubtitle = LoaderSubtitle[..index];
            await InvokeAsync(StateHasChanged);
            await Task.Delay(42, cancellationToken);
        }

        await Task.Delay(3000, cancellationToken);

        if (sequence != _navigationSequence)
        {
            return;
        }

        _loaderVisible = false;
        await InvokeAsync(StateHasChanged);
    }

    private static bool IsHomePath(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return true;
        }

        var cleanPath = path.Split('?', '#')[0].Trim('/');
        return string.IsNullOrEmpty(cleanPath);
    }
}
